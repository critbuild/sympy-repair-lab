@@ -1,4 +1,5 @@
 import decimal
+import operator
 from sympy import (Rational, Symbol, Float, I, sqrt, oo, nan, pi, E, Integer,
                    S, factorial, Catalan, EulerGamma, GoldenRatio, cos, exp,
                    Number, zoo, log, Mul, Pow, Tuple, latex, Gt, Lt, Ge, Le,
@@ -1372,6 +1373,83 @@ def test_relational():
     assert (x == cos) is False
 
 
+def test_comparison_unknown_type():
+    class Comparable(object):
+        def __eq__(self, other):
+            return 'eq'
+
+        def __ne__(self, other):
+            return 'ne'
+
+        def __lt__(self, other):
+            return 'lt'
+
+        def __le__(self, other):
+            return 'le'
+
+        def __gt__(self, other):
+            return 'gt'
+
+        def __ge__(self, other):
+            return 'ge'
+
+    other = Comparable()
+    unknown = object()
+    comparisons = (
+        (operator.eq, '__eq__', 'eq'),
+        (operator.ne, '__ne__', 'ne'),
+        (operator.lt, '__lt__', 'gt'),
+        (operator.le, '__le__', 'ge'),
+        (operator.gt, '__gt__', 'lt'),
+        (operator.ge, '__ge__', 'le'),
+    )
+    for expr in (S.Zero, S.One, S.NegativeOne, Integer(2), Rational(2, 3),
+                 Float(1.5), pi, E, oo, -oo, nan, zoo, I, Symbol('x')):
+        for op, method, reflected in comparisons:
+            assert getattr(expr, method)(other) is NotImplemented
+            assert getattr(expr, method)(unknown) is NotImplemented
+            assert op(expr, other) == reflected
+            assert op(other, expr) == method[2:-2]
+            if op is operator.eq:
+                assert op(expr, unknown) is False
+            elif op is operator.ne:
+                assert op(expr, unknown) is True
+            else:
+                raises(TypeError, lambda: op(expr, unknown))
+
+
+def test_comparison_supported_types():
+    class Convertible(object):
+        def _sympy_(self):
+            return Rational(2, 3)
+
+    other = Convertible()
+    assert Rational(2, 3).__eq__(other) is True
+    assert Rational(2, 3).__ne__(other) is False
+    assert (Integer(1) > other) is S.true
+    assert (Float(0.5) < other) is S.true
+    assert (pi > other) is S.true
+
+    x = Symbol('x')
+    comparisons = ((operator.lt, Lt), (operator.le, Le),
+                   (operator.gt, Gt), (operator.ge, Ge))
+    for expr in (Integer(2), Rational(2, 3), Float(1.5), pi, oo, -oo):
+        assert (expr == x) is False
+        assert (expr != x) is True
+        for op, relation in comparisons:
+            assert op(expr, x) == relation(expr, x, evaluate=False)
+
+    for expr in (nan, zoo, I):
+        for op, relation in comparisons:
+            raises(TypeError, lambda: op(expr, S.One))
+
+    # These singletons retain structural identity equality, without coercion.
+    assert (oo == float('inf')) is False
+    assert (-oo == float('-inf')) is False
+    assert (nan == float('nan')) is False
+    assert (nan == nan) is True
+
+
 def test_Integer_as_index():
     assert 'hello'[Integer(2):] == 'llo'
 
