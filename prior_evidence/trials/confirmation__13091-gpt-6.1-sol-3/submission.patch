diff --git a/sympy/core/tests/test_basic.py b/sympy/core/tests/test_basic.py
index 9d4a8fa..1c4c80e 100644
--- a/sympy/core/tests/test_basic.py
+++ b/sympy/core/tests/test_basic.py
@@ -39,6 +39,31 @@ def test_equality():
     assert not(Basic() == 0)
 
 
+def test_equality_unknown_type():
+    class Comparable(object):
+        def __eq__(self, other):
+            return isinstance(other, Basic)
+
+        def __ne__(self, other):
+            # Deliberately independent of __eq__ to check __ne__ dispatch.
+            return isinstance(other, Basic)
+
+    other = Comparable()
+    for expr in (Basic(), symbols('x'), sin(symbols('x'))):
+        assert expr.__eq__(other) is NotImplemented
+        assert expr.__ne__(other) is NotImplemented
+        assert (expr == other) is True
+        assert (other == expr) is True
+        assert (expr != other) is True
+        assert (other != expr) is True
+
+        unknown = object()
+        assert expr.__eq__(unknown) is NotImplemented
+        assert expr.__ne__(unknown) is NotImplemented
+        assert (expr == unknown) is False
+        assert (expr != unknown) is True
+
+
 def test_matches_basic():
     instances = [Basic(b1, b1, b2), Basic(b1, b2, b1), Basic(b2, b1, b1),
                  Basic(b1, b2), Basic(b2, b1), b2, b1]
