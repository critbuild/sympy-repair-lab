@@ -1653,3 +1653,78 @@ def test_mod_inverse():
 
 def test_golden_ratio_rewrite_as_sqrt():
     assert GoldenRatio.rewrite(sqrt) == S.Half + sqrt(5)*S.Half
+
+
+def test_comparison_unknown_type():
+    import operator
+
+    # Distinct, non-boolean results verify both reflection and that __ne__
+    # does not negate NotImplemented (or the reflected __eq__ result).
+    class Reflected(object):
+        def __eq__(self, other):
+            return ('eq', other)
+
+        def __ne__(self, other):
+            return ('ne', other)
+
+        def __lt__(self, other):
+            return ('lt', other)
+
+        def __le__(self, other):
+            return ('le', other)
+
+        def __gt__(self, other):
+            return ('gt', other)
+
+        def __ge__(self, other):
+            return ('ge', other)
+
+    comparisons = [(operator.eq, 'eq', 'eq'), (operator.ne, 'ne', 'ne'),
+                   (operator.lt, 'lt', 'gt'), (operator.le, 'le', 'ge'),
+                   (operator.gt, 'gt', 'lt'), (operator.ge, 'ge', 'le')]
+    x = Symbol('x')
+    values = [S.Zero, S.One, S.NegativeOne, Integer(2), Rational(2, 3),
+              Float('1.25'), pi, E, oo, -oo, nan, zoo, I, x, x + 1]
+    other = Reflected()
+    unknown = object()
+    for value in values:
+        for op, name, reflected in comparisons:
+            method = getattr(value, '__%s__' % name)
+            assert method(other) is NotImplemented
+            assert method(unknown) is NotImplemented
+            assert op(value, other) == (reflected, value)
+            assert op(other, value) == (name, value)
+            if name in ('eq', 'ne'):
+                assert op(value, unknown) is (name == 'ne')
+                assert op(unknown, value) is (name == 'ne')
+            else:
+                raises(TypeError, lambda: op(value, unknown))
+                raises(TypeError, lambda: op(unknown, value))
+
+
+def test_comparison_sympifiable_and_symbolic():
+    class One(object):
+        def _sympy_(self):
+            return S.One
+
+    one = One()
+    for value in [S.One, Rational(1, 2), Float('1.25'), pi]:
+        assert (value == one) == (value == S.One)
+        assert (value != one) == (value != S.One)
+        assert (value < one) == (value < S.One)
+        assert (value <= one) == (value <= S.One)
+        assert (value > one) == (value > S.One)
+        assert (value >= one) == (value >= S.One)
+
+    x = Symbol('x')
+    for value in [S.One, Rational(1, 2), Float('1.25'), pi, oo, -oo]:
+        assert (value < x) == Lt(value, x, evaluate=False)
+        assert (value <= x) == Le(value, x, evaluate=False)
+        assert (value > x) == Gt(value, x, evaluate=False)
+        assert (value >= x) == Ge(value, x, evaluate=False)
+    # Preserve structural equality of numeric singletons, without coercion.
+    for value, native in [(oo, float('inf')), (-oo, float('-inf')),
+                          (nan, float('nan'))]:
+        assert value == value
+        assert not (value != value)
+        assert value != native
