index 9d4a8fa..e90a81a 100644
--- a/sympy/core/tests/test_basic.py
+++ b/sympy/core/tests/test_basic.py
@@ -39,6 +39,30 @@ def test_equality():
     assert not(Basic() == 0)
 
 
+def test_equality_unknown_type():
+    class EqualToBasic(object):
+        def __eq__(self, other):
+            return isinstance(other, Basic)
+
+        def __ne__(self, other):
+            return not isinstance(other, Basic)
+
+    other = EqualToBasic()
+    for basic in [b1, b2, symbols('x')]:
+        assert basic.__eq__(other) is NotImplemented
+        assert basic.__ne__(other) is NotImplemented
+        assert basic == other
+        assert other == basic
+        assert not (basic != other)
+        assert not (other != basic)
+
+        unknown = object()
+        assert basic.__eq__(unknown) is NotImplemented
+        assert basic.__ne__(unknown) is NotImplemented
+        assert (basic == unknown) is False
+        assert (basic != unknown) is True
+
+
 def test_matches_basic():
     instances = [Basic(b1, b1, b2), Basic(b1, b2, b1), Basic(b2, b1, b1),
                  Basic(b1, b2), Basic(b2, b1), b2, b1]
