+def test_comparison_unknown_type():
+    from operator import eq, ne, lt, le, gt, ge
+
+    # Distinct, non-boolean results check that reflection returns the result
+    # unchanged, including for __ne__ (which must not negate NotImplemented).
+    results = dict((name, object()) for name in
+                   ('__eq__', '__ne__', '__lt__', '__le__', '__gt__', '__ge__'))
+
+    class Comparable(object):
+        def __eq__(self, other):
+            return results['__eq__']
+
+        def __ne__(self, other):
+            return results['__ne__']
+
+        def __lt__(self, other):
+            return results['__lt__']
+
+        def __le__(self, other):
+            return results['__le__']
+
+        def __gt__(self, other):
+            return results['__gt__']
+
+        def __ge__(self, other):
+            return results['__ge__']
+
+    other = Comparable()
+    unknown = object()
+    comparisons = ((eq, '__eq__', '__eq__'), (ne, '__ne__', '__ne__'),
+                   (lt, '__lt__', '__gt__'), (le, '__le__', '__ge__'),
+                   (gt, '__gt__', '__lt__'), (ge, '__ge__', '__le__'))
+    for value in (S.Zero, S.One, S.NegativeOne, Integer(2), Rational(1, 2),
+                  Float('0.5'), pi, E, oo, -oo, nan, zoo, I, Symbol('x')):
+        for op, method, reflected in comparisons:
+            assert getattr(value, method)(other) is NotImplemented
+            assert op(value, other) is results[reflected]
+            assert op(other, value) is results[method]
+            assert getattr(value, method)(unknown) is NotImplemented
+            if op in (eq, ne):
+                assert op(value, unknown) is (op is ne)
+                assert op(unknown, value) is (op is ne)
+            else:
+                raises(TypeError, lambda: op(value, unknown))
+                raises(TypeError, lambda: op(unknown, value))
+
+
+def test_comparison_sympifiable_and_symbolic():
+    from operator import lt, le, gt, ge
+
+    class Convertible(object):
+        def _sympy_(self):
+            return Rational(1, 2)
+
+    other = Convertible()
+    assert Rational(1, 2) == other
+    assert Integer(2) != other
+    assert Float('0.5') == other
+    assert pi != other
+    for value in (oo, -oo, nan):
+        assert value != other
+    assert Integer(1) == 1
+    assert Float('0.5') == 0.5
+    assert S.NaN == S.NaN
+    x = Symbol('x')
+    for op in (lt, le, gt, ge):
+        for value in (Integer(2), Rational(1, 2), Float('0.5'), pi):
+            assert op(value, other) == op(value, Rational(1, 2))
+        for value in (Integer(2), Rational(1, 2), Float('0.5'), pi, oo, -oo):
+            relation = op(value, x)
+            assert relation.is_Relational
+            raises(TypeError, lambda: bool(relation))
+        raises(TypeError, lambda: op(S.One, I))
+        raises(TypeError, lambda: op(S.One, nan))
+
+
