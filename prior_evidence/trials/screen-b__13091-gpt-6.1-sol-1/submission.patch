diff --git a/sympy/core/tests/test_basic.py b/sympy/core/tests/test_basic.py
index 9d4a8fa..eda9111 100644
--- a/sympy/core/tests/test_basic.py
+++ b/sympy/core/tests/test_basic.py
@@ -39,6 +39,32 @@ def test_equality():
     assert not(Basic() == 0)
 
 
+def test_equality_unknown_type():
+    class Comparable(object):
+        def __eq__(self, other):
+            return isinstance(other, Basic)
+
+        def __ne__(self, other):
+            return not isinstance(other, Basic)
+
+    other = Comparable()
+    for b in (b1, b2, symbols('x'), sin(symbols('x'))):
+        assert b.__eq__(other) is NotImplemented
+        assert b.__ne__(other) is NotImplemented
+        assert (b == other) is True
+        assert (other == b) is True
+        assert (b != other) is False
+        assert (other != b) is False
+
+        unknown = object()
+        assert b.__eq__(unknown) is NotImplemented
+        assert b.__ne__(unknown) is NotImplemented
+        assert (b == unknown) is False
+        assert (unknown == b) is False
+        assert (b != unknown) is True
+        assert (unknown != b) is True
+
+
