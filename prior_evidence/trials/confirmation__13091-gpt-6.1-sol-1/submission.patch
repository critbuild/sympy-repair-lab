 from sympy import (Rational, Symbol, Float, I, sqrt, oo, nan, pi, E, Integer,
                    S, factorial, Catalan, EulerGamma, GoldenRatio, cos, exp,
                    Number, zoo, log, Mul, Pow, Tuple, latex, Gt, Lt, Ge, Le,
@@ -24,6 +25,82 @@ def same_and_same_prec(a, b):
     return a == b and a._prec == b._prec
 
 
+def test_comparison_unknown_type():
+    # Distinct results verify which reflected method Python calls, and that
+    # the result is returned without converting it to bool.
+    class Comparable:
+        def __eq__(self, other):
+            return 'eq'
+
+        def __ne__(self, other):
+            return 'ne'
+
+        def __lt__(self, other):
+            return 'lt'
+
+        def __le__(self, other):
+            return 'le'
+
+        def __gt__(self, other):
+            return 'gt'
+
+        def __ge__(self, other):
+            return 'ge'
+
+    other = Comparable()
+    unknown = object()
+    x = Symbol('x')
+    values = (S.Zero, S.One, S.NegativeOne, Integer(2), Rational(2, 3),
+              S.Half, Float(1.5), pi, E, Catalan, EulerGamma, GoldenRatio,
+              oo, -oo, nan, zoo, I, x, x + 1)
+    comparisons = ((operator.eq, 'eq', 'eq'), (operator.ne, 'ne', 'ne'),
+                   (operator.lt, 'lt', 'gt'), (operator.le, 'le', 'ge'),
+                   (operator.gt, 'gt', 'lt'), (operator.ge, 'ge', 'le'))
+    for value in values:
+        for op, method, reflected in comparisons:
+            assert getattr(value, '__%s__' % method)(other) is NotImplemented
+            assert op(value, other) == reflected
+            assert op(other, value) == method
+            assert getattr(value, '__%s__' % method)(unknown) is NotImplemented
+            if method == 'eq':
+                assert op(value, unknown) is False
+            elif method == 'ne':
+                assert op(value, unknown) is True
+            else:
+                raises(TypeError, lambda: op(value, unknown))
+                raises(TypeError, lambda: op(unknown, value))
+
+
+def test_comparison_known_operands():
+    class Convertible:
+        def _sympy_(self):
+            return Integer(2)
+
+    other = Convertible()
+    assert Integer(2) == other
+    assert not (Integer(2) != other)
+    assert Integer(1) < other
+    assert Float(3) > other
+    assert Rational(1, 2) <= other
+    assert pi >= other
+
+    x = Symbol('x')
+    for value in (Integer(2), Rational(2, 3), Float(1.5), pi, oo, -oo):
+        assert (value < x) == Lt(value, x, evaluate=False)
+        assert (value <= x) == Le(value, x, evaluate=False)
+        assert (value > x) == Gt(value, x, evaluate=False)
+        assert (value >= x) == Ge(value, x, evaluate=False)
+        for op in (operator.lt, operator.le, operator.gt, operator.ge):
+            raises(TypeError, lambda: op(value, I))
+            raises(TypeError, lambda: op(value, nan))
+
+    # Singleton equality remains structural, including for Python floats.
+    for value, other in ((oo, float('inf')), (-oo, -float('inf')),
+                         (nan, float('nan'))):
+        assert (value == other) is False
+        assert (value != other) is True
+
+
