+++ b/sympy/core/tests/test_numbers.py
@@ -24,6 +24,84 @@ def same_and_same_prec(a, b):
     return a == b and a._prec == b._prec
 
 
+def test_comparison_unknown_type():
+    import operator
+
+    class Reflected(object):
+        def __eq__(self, other):
+            return ('eq', other)
+
+        def __ne__(self, other):
+            return ('ne', other)
+
+        def __lt__(self, other):
+            return ('lt', other)
+
+        def __le__(self, other):
+            return ('le', other)
+
+        def __gt__(self, other):
+            return ('gt', other)
+
+        def __ge__(self, other):
+            return ('ge', other)
+
+    unknown = object()
+    reflected = Reflected()
+    x = Symbol('x')
+    values = (S.Zero, S.One, S.NegativeOne, Integer(2), Rational(2, 3),
+              Float(1.5), oo, -oo, nan, zoo, I, pi, E, x, x + 1)
+    comparisons = ((operator.eq, 'eq', 'eq'), (operator.ne, 'ne', 'ne'),
+                   (operator.lt, 'lt', 'gt'), (operator.le, 'le', 'ge'),
+                   (operator.gt, 'gt', 'lt'), (operator.ge, 'ge', 'le'))
+    for value in values:
+        for op, name, reverse in comparisons:
+            method = getattr(value, '__%s__' % name)
+            assert method(unknown) is NotImplemented
+            assert method(reflected) is NotImplemented
+            assert op(value, reflected) == (reverse, value)
+            assert op(reflected, value) == (name, value)
+            if name == 'eq':
+                assert op(value, unknown) is False
+                assert op(unknown, value) is False
+            elif name == 'ne':
+                assert op(value, unknown) is True
+                assert op(unknown, value) is True
+            else:
+                raises(TypeError, lambda: op(value, unknown))
+                raises(TypeError, lambda: op(unknown, value))
+
+
+def test_comparison_supported_operands():
+    import operator
+
+    class Convertible(object):
+        def _sympy_(self):
+            return Integer(2)
+
+    x = Symbol('x')
+    for op, relation in ((operator.lt, Lt), (operator.le, Le),
+                         (operator.gt, Gt), (operator.ge, Ge)):
+        for value in (Integer(2), Rational(2, 3), Float(1.5), pi, oo, -oo):
+            assert op(value, x) == relation(value, x, evaluate=False)
+            assert op(value, Convertible()) == op(value, Integer(2))
+        raises(TypeError, lambda: op(nan, Integer(2)))
+        raises(TypeError, lambda: op(Integer(2), I))
+
+    for value in (Integer(2), Rational(2, 3), Float(1.5), pi):
+        assert (value == Convertible()) == (value == Integer(2))
+        assert (value != Convertible()) == (value != Integer(2))
+
+    # These singleton comparisons have historically used identity, even
+    # when the other operand can be converted to the same singleton.
+    for value, native in ((oo, float('inf')), (-oo, float('-inf')),
+                          (nan, float('nan'))):
+        assert value.__eq__(value) is True
+        assert value.__ne__(value) is False
+        assert value.__eq__(native) is False
+        assert value.__ne__(native) is True
+
+
