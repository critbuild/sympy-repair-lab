+def test_equality_unknown_type():
+    class Equal(object):
+        def __eq__(self, other):
+            return isinstance(other, Basic)
+
+    class Unequal(object):
+        def __ne__(self, other):
+            return isinstance(other, Basic)
+
+    unknown = object()
+    assert b1.__eq__(unknown) is NotImplemented
+    assert b1.__ne__(unknown) is NotImplemented
+    assert (b1 == unknown) is False
+    assert (b1 != unknown) is True
+    assert b1 == Equal()
+    assert Equal() == b1
+    assert b1 != Unequal()
+    assert Unequal() != b1
+
+    class Convertible(object):
+        def _sympy_(self):
+            return b1
+
+    assert b1 == Convertible()
+    assert not (b1 != Convertible())
+
+
