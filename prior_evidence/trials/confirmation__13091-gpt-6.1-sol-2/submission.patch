     assert (x == cos) is False
 
 
+def test_comparison_unknown_type():
+    from operator import eq, ne, lt, le, gt, ge
+
+    results = [object() for i in range(6)]
+
+    class Other(object):
+        def __eq__(self, other):
+            return results[0]
+
+        def __ne__(self, other):
+            return results[1]
+
+        def __lt__(self, other):
+            return results[2]
+
+        def __le__(self, other):
+            return results[3]
+
+        def __gt__(self, other):
+            return results[4]
+
+        def __ge__(self, other):
+            return results[5]
+
+    other = Other()
+    unknown = object()
+    comparisons = [(eq, '__eq__', 0, 0), (ne, '__ne__', 1, 1),
+                   (lt, '__lt__', 2, 4), (le, '__le__', 3, 5),
+                   (gt, '__gt__', 4, 2), (ge, '__ge__', 5, 3)]
+    for expr in (S.Zero, S.One, S.NegativeOne, Integer(2), Rational(2, 3),
+                 Float('1.25'), oo, -oo, nan, pi, E, I, zoo,
+                 Symbol('x'), Symbol('r', real=True)):
+        for op, method, forward, reflected in comparisons:
+            assert getattr(expr, method)(other) is NotImplemented
+            assert getattr(expr, method)(unknown) is NotImplemented
+            assert op(expr, other) is results[reflected]
+            assert op(other, expr) is results[forward]
+            if op is eq:
+                assert op(expr, unknown) is False
+                assert op(unknown, expr) is False
+            elif op is ne:
+                assert op(expr, unknown) is True
+                assert op(unknown, expr) is True
+            else:
+                raises(TypeError, lambda: op(expr, unknown))
+                raises(TypeError, lambda: op(unknown, expr))
+
+    for op, method, forward, reflected in comparisons[2:]:
+        assert getattr(Number, method)(S.One, other) is NotImplemented
+
+
+def test_comparison_sympifiable_type():
+    class Other(object):
+        def _sympy_(self):
+            return S.One
+
+    other = Other()
+    for expr in (S.One, Float(1)):
+        assert (expr == other) is True
+        assert (expr != other) is False
+        assert (expr <= other) is S.true
+        assert (expr >= other) is S.true
+        assert (expr < other) is S.false
+        assert (expr > other) is S.false
+
+    # These singleton equalities have historically compared identity,
+    # even when the operand can be converted to the same SymPy singleton.
+    for expr, value in ((oo, float('inf')), (-oo, float('-inf')),
+                        (nan, float('nan'))):
+        assert (expr == value) is False
+        assert (expr != value) is True
+        assert (expr == expr) is True
+        assert (expr != expr) is False
+
+
+def test_comparison_symbolic():
+    from operator import lt, le, gt, ge
+
+    x = Symbol('x')
+    comparisons = ((lt, Lt), (le, Le), (gt, Gt), (ge, Ge))
+    for expr in (S.Zero, Rational(2, 3), Float('1.25'), pi, oo, -oo):
+        assert (expr == x) is False
+        assert (expr != x) is True
+        for op, relation in comparisons:
+            assert op(expr, x) == relation(expr, x, evaluate=False)
+
+    for expr in (I, zoo, nan):
+        for op, relation in comparisons:
+            raises(TypeError, lambda: op(expr, S.One))
+
+
