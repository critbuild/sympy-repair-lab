diff --git a/sympy/core/tests/test_basic.py b/sympy/core/tests/test_basic.py
index 9d4a8fa..bf07913 100644
--- a/sympy/core/tests/test_basic.py
+++ b/sympy/core/tests/test_basic.py
@@ -39,6 +39,32 @@ def test_equality():
     assert not(Basic() == 0)
 
 
+def test_equality_unknown_type():
+    eq_result, ne_result = object(), object()
+
+    class Other(object):
+        def __eq__(self, other):
+            return eq_result
+
+        def __ne__(self, other):
+            return ne_result
+
+    other = Other()
+    for basic in (b1, b2, symbols('x')):
+        assert basic.__eq__(other) is NotImplemented
+        assert basic.__ne__(other) is NotImplemented
+        assert (basic == other) is eq_result
+        assert (other == basic) is eq_result
+        assert (basic != other) is ne_result
+        assert (other != basic) is ne_result
+
+        unknown = object()
+        assert (basic == unknown) is False
+        assert (unknown == basic) is False
+        assert (basic != unknown) is True
+        assert (unknown != basic) is True
+
+
