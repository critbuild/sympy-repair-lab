diff --git a/sympy/core/tests/test_basic.py b/sympy/core/tests/test_basic.py
index 9d4a8fa..ae27fa7 100644
--- a/sympy/core/tests/test_basic.py
+++ b/sympy/core/tests/test_basic.py
@@ -39,6 +39,32 @@ def test_equality():
     assert not(Basic() == 0)
 
 
+def test_equality_unknown_type():
+    class EqualToBasic(object):
+        def __eq__(self, other):
+            return isinstance(other, Basic)
+
+        def __ne__(self, other):
+            return not isinstance(other, Basic)
+
+    basic = Basic()
+    other = EqualToBasic()
+    assert basic.__eq__(other) is NotImplemented
+    assert basic.__ne__(other) is NotImplemented
+    assert basic == other
+    assert other == basic
+    assert not (basic != other)
+    assert not (other != basic)
+
+    unknown = object()
+    assert basic.__eq__(unknown) is NotImplemented
+    assert basic.__ne__(unknown) is NotImplemented
+    assert not (basic == unknown)
+    assert basic != unknown
+    assert basic.__eq__(0) is False
+    assert basic.__ne__(0) is True
+
+
 def test_matches_basic():
     instances = [Basic(b1, b1, b2), Basic(b1, b2, b1), Basic(b2, b1, b1),
                  Basic(b1, b2), Basic(b2, b1), b2, b1]
diff --git a/sympy/core/tests/test_numbers.py b/sympy/core/tests/test_numbers.py
index a09ff11..399767c 100644
--- a/sympy/core/tests/test_numbers.py
+++ b/sympy/core/tests/test_numbers.py
@@ -1653,3 +1653,84 @@ def test_mod_inverse():
 
 def test_golden_ratio_rewrite_as_sqrt():
     assert GoldenRatio.rewrite(sqrt) == S.Half + sqrt(5)*S.Half
+
+
+def test_comparison_unknown_type():
+    import operator
+
+    class Reflected(object):
+        def __eq__(self, other):
+            return 'eq'
+
+        def __ne__(self, other):
+            return 'ne'
+
+        def __lt__(self, other):
+            return 'lt'
+
+        def __le__(self, other):
+            return 'le'
+
+        def __gt__(self, other):
+            return 'gt'
+
+        def __ge__(self, other):
+            return 'ge'
+
+    other = Reflected()
+    unknown = object()
+    values = [S.Zero, S.One, S.NegativeOne, Integer(2), S.Half,
+              Rational(2, 3), Float('1.25'), oo, -oo, nan, zoo,
+              pi, E, GoldenRatio, EulerGamma, Catalan, I,
+              Symbol('x'), Symbol('x') + 1]
+    for value in values:
+        for name, reflected in [('eq', 'eq'), ('ne', 'ne'),
+                                ('lt', 'gt'), ('le', 'ge'),
+                                ('gt', 'lt'), ('ge', 'le')]:
+            method = getattr(value, '__%s__' % name)
+            op = getattr(operator, name)
+            assert method(other) is NotImplemented
+            assert method(unknown) is NotImplemented
+            assert op(value, other) == reflected
+            assert op(other, value) == name
+            if name == 'eq':
+                assert op(value, unknown) is False
+            elif name == 'ne':
+                assert op(value, unknown) is True
+            else:
+                raises(TypeError, lambda: op(value, unknown))
+                raises(TypeError, lambda: op(unknown, value))
+
+
+def test_comparison_sympifiable_and_symbolic():
+    class Convertible(object):
+        def _sympy_(self):
+            return Integer(2)
+
+    other = Convertible()
+    for value in [Integer(2), Rational(2), Float(2)]:
+        assert value == other
+        assert not (value != other)
+        assert (value <= other) is S.true
+        assert (value >= other) is S.true
+        assert (value < other) is S.false
+        assert (value > other) is S.false
+
+    x = Symbol('x')
+    for value in [Integer(2), Rational(2, 3), Float(2), pi, oo, -oo]:
+        assert value.__eq__(x) is False
+        assert value.__ne__(x) is True
+        for name, relation in [('__lt__', Lt), ('__le__', Le),
+                               ('__gt__', Gt), ('__ge__', Ge)]:
+            assert getattr(value, name)(x) == relation(value, x, evaluate=False)
+
+    # The singleton numbers retain structural (not converted) equality.
+    for value, native in [(oo, float('inf')), (-oo, float('-inf')),
+                          (nan, float('nan'))]:
+        assert value == value
+        assert not (value != value)
+        assert value.__eq__(native) is False
+        assert value.__ne__(native) is True
+    for value in [nan, zoo, I]:
+        raises(TypeError, lambda: value < 1)
+        raises(TypeError, lambda: value >= 1)
