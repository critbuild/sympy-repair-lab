diff --git a/sympy/core/tests/test_basic.py b/sympy/core/tests/test_basic.py
index 9d4a8fa..191bede 100644
--- a/sympy/core/tests/test_basic.py
+++ b/sympy/core/tests/test_basic.py
@@ -39,6 +39,39 @@ def test_equality():
     assert not(Basic() == 0)
 
 
+def test_equality_unknown_type():
+    class Foo(object):
+        def __init__(self, value):
+            self.value = value
+
+        def __eq__(self, other):
+            if isinstance(other, Basic):
+                return self.value == other
+            return NotImplemented
+
+        def __ne__(self, other):
+            if isinstance(other, Basic):
+                return self.value != other
+            return NotImplemented
+
+    for value in (b1, b2, symbols('x')):
+        other = Foo(value)
+        assert value.__eq__(other) is NotImplemented
+        assert value.__ne__(other) is NotImplemented
+        assert (value == other) is True
+        assert (other == value) is True
+        assert (value != other) is False
+        assert (other != value) is False
+
+        unknown = object()
+        assert value.__eq__(unknown) is NotImplemented
+        assert value.__ne__(unknown) is NotImplemented
+        assert (value == unknown) is False
+        assert (unknown == value) is False
+        assert (value != unknown) is True
+        assert (unknown != value) is True
+
+
 def test_matches_basic():
     instances = [Basic(b1, b1, b2), Basic(b1, b2, b1), Basic(b2, b1, b1),
                  Basic(b1, b2), Basic(b2, b1), b2, b1]
