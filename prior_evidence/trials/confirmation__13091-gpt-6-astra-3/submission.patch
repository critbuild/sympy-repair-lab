@@ -19,6 +20,82 @@
 
 t = Symbol('t', real=False)
 
+
+def test_comparison_unknown_type():
+    class Other(object):
+        def __eq__(self, other):
+            return 'eq'
+
+        def __ne__(self, other):
+            return 'ne'
+
+        def __lt__(self, other):
+            return 'lt'
+
+        def __le__(self, other):
+            return 'le'
+
+        def __gt__(self, other):
+            return 'gt'
+
+        def __ge__(self, other):
+            return 'ge'
+
+    other = Other()
+    unknown = object()
+    values = (S.Zero, S.One, S.NegativeOne, Integer(2), Rational(2, 3),
+              Float(1.5), pi, E, EulerGamma, oo, -oo, nan, zoo, I,
+              Symbol('x'), Symbol('x') + 1)
+    for value in values:
+        for name, reflected in (('eq', 'eq'), ('ne', 'ne'),
+                                ('lt', 'gt'), ('le', 'ge'),
+                                ('gt', 'lt'), ('ge', 'le')):
+            method = getattr(value, '__%s__' % name)
+            compare = getattr(operator, name)
+            assert method(other) is NotImplemented
+            assert method(unknown) is NotImplemented
+            assert compare(value, other) == reflected
+            assert compare(other, value) == name
+            if name == 'eq':
+                assert compare(value, unknown) is False
+                assert compare(unknown, value) is False
+            elif name == 'ne':
+                assert compare(value, unknown) is True
+                assert compare(unknown, value) is True
+            else:
+                raises(TypeError, lambda: compare(value, unknown))
+                raises(TypeError, lambda: compare(unknown, value))
+
+
+def test_comparison_symbolic_and_sympifiable():
+    class Other(object):
+        def _sympy_(self):
+            return S.One
+
+    other = Other()
+    x = Symbol('x')
+    for value in (Integer(2), Rational(2, 3), Float(1.5), pi, x):
+        for name in ('eq', 'ne', 'lt', 'le', 'gt', 'ge'):
+            compare = getattr(operator, name)
+            assert compare(value, other) == compare(value, S.One)
+        assert value.__eq__(x) is (value is x)
+        assert value.__ne__(x) is (value is not x)
+        for name, relation in (('lt', Lt), ('le', Le), ('gt', Gt), ('ge', Ge)):
+            if value is not x:
+                assert getattr(operator, name)(value, x) == relation(value, x)
+
+    # The singleton numbers retain structural equality and invalid ordering.
+    for value, native in ((oo, float('inf')), (-oo, float('-inf')),
+                          (nan, float('nan'))):
+        assert (value == value) is True
+        assert (value != value) is False
+        assert (value == native) is False
+    for value in (Integer(2), Rational(2, 3), Float(1.5), pi, x, oo, -oo):
+        for compare in (operator.lt, operator.le, operator.gt, operator.ge):
+            raises(TypeError, lambda: compare(value, nan))
+            raises(TypeError, lambda: compare(value, I))
+
+
 def same_and_same_prec(a, b):
     # stricter matching for Floats
     return a == b and a._prec == b._prec
