@@ -623,6 +623,56 @@ def test_ProductSet_of_single_arg_is_not_arg():
     assert unchanged(ProductSet, ProductSet(Interval(0, 1)))
 
 
+def test_ProductSet_finite_comparisons():
+    a = FiniteSet(1, 2)
+    product = ProductSet(a, a)
+    explicit = FiniteSet((1, 1), (1, 2), (2, 1), (2, 2))
+    assert product.rewrite(FiniteSet) == explicit
+    assert product.intersect(explicit) == explicit.intersect(product)
+    assert product.is_subset(explicit) is True
+    assert explicit.is_subset(product) is True
+    for lhs, rhs in [(product, explicit), (explicit, product)]:
+        assert Eq(lhs, rhs) is S.true
+        assert Eq(lhs, rhs, evaluate=False).simplify() is S.true
+
+    smaller = FiniteSet((1, 1), (1, 2), (2, 1))
+    larger = explicit | FiniteSet((3, 3))
+    assert product.is_subset(smaller) is False
+    assert smaller.is_subset(product) is True
+    assert product.is_subset(larger) is True
+    assert larger.is_subset(product) is False
+    for other in [smaller, larger, FiniteSet(1, 2), FiniteSet((1,))]:
+        assert Eq(product, other) is S.false
+        assert Eq(other, product) is S.false
+
+    symbolic = ProductSet(FiniteSet(x), FiniteSet(1))
+    target = FiniteSet((y, 1))
+    assert symbolic.rewrite(FiniteSet) == FiniteSet((x, 1))
+    assert symbolic.is_subset(target) is None
+    assert target.is_subset(symbolic) is None
+    assert Eq(symbolic, target).is_Equality
+    assert Eq(symbolic, target).simplify().is_Equality
+    assert Eq(symbolic, target).subs(y, x) is S.true
+    assert Eq(symbolic, target).subs(y, x + 1) is S.false
+    assert symbolic.is_subset(FiniteSet((x, 1))) is True
+    assert symbolic.is_subset(FiniteSet((x + 1, 1))) is False
+
+
+def test_ProductSet_rewrite_FiniteSet():
+    a = FiniteSet(1, 2)
+    assert ProductSet(a).rewrite(FiniteSet) == FiniteSet((1,), (2,))
+    assert ProductSet(ProductSet(a), a).rewrite(FiniteSet) == FiniteSet(
+        ((1,), 1), ((1,), 2), ((2,), 1), ((2,), 2))
+    assert ProductSet().rewrite(FiniteSet) == FiniteSet(())
+    assert ProductSet(a, S.EmptySet).rewrite(FiniteSet) is S.EmptySet
+    for product in [ProductSet(a, S.Integers),
+                    ProductSet(a, Interval(0, 1)),
+                    ProductSet(a, Interval(x, y))]:
+        assert product.rewrite(FiniteSet) == product
+    assert ProductSet(a, S.Integers).is_subset(FiniteSet((1, 1))) is False
+    assert ProductSet(a, Interval(x, y)).is_subset(FiniteSet((1, 1))) is None
+
+
