+def test_mul_ground_EX_zero():
+    # This coefficient becomes literal zero only during EX arithmetic.
+    a = EX(18**Rational(1, 3) - 2**Rational(1, 3)*3**Rational(2, 3))
+    assert a != EX.zero
+    assert a*EX(3) == EX.zero
+    assert dup_mul_ground([a], EX(3), EX) == []
+    assert dup_mul_ground([a, EX.one, a], EX(3), EX) == [EX(3), EX.zero]
+    assert dmp_mul_ground([[a], [a]], EX(3), 1, EX) == [[]]
+    assert dmp_mul_ground([[a], [a, EX.one, a]], EX(3), 1, EX) == [
+        [EX(3), EX.zero]]
+    assert dmp_mul_ground([[[a]], [[a]]], EX(3), 2, EX) == [[[]]]
+    assert dmp_mul_ground([[EX.one], [EX.one]], EX.zero, 1, EX) == [[]]
+
