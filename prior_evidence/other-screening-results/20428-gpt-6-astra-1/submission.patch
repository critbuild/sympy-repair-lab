+def test_Poly_clear_denoms_EX_zero():
+    # Reduced reproducer for issue 20428: clearing the denominator simplifies
+    # a coefficient to zero, so its dense representation must be stripped.
+    a = (18**Rational(1, 3) - 2**Rational(1, 3)*3**Rational(2, 3))/3
+    for gens in ((x,), (x, y), (x, y, z)):
+        zero = Poly(0, *gens, domain=EX)
+        for convert in (False, True):
+            coeff, poly = Poly(a, *gens, domain=EX).clear_denoms(convert=convert)
+            assert coeff == 3
+            assert poly.rep == zero.rep
+            assert poly.is_zero
+            assert poly.as_expr() == 0
+            assert poly.terms_gcd() == ((0,)*len(gens), zero)
+            assert poly.primitive() == (0, zero)
+
+            # Remove vanished leading terms without losing the remaining ones.
+            f = Poly(a*x**2 + a*gens[-1] + S.One/3, *gens, domain=EX)
+            assert f.clear_denoms(convert=convert) == (
+                3, Poly(1, *gens, domain=EX))
+
+    # Undecidable coefficients must survive normalization.
+    assert sin(z).is_zero is None
+    for gens in ((x,), (x, y)):
+        for convert in (False, True):
+            f = Poly(sin(z)*x/3 + S.One/3, *gens, domain=EX)
+            assert f.clear_denoms(convert=convert) == (
+                3, Poly(sin(z)*x + 1, *gens, domain=EX))
+
+
