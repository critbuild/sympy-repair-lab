diff --git a/sympy/polys/tests/test_factortools.py b/sympy/polys/tests/test_factortools.py
index 7bcd935..edff217 100644
--- a/sympy/polys/tests/test_factortools.py
+++ b/sympy/polys/tests/test_factortools.py
@@ -497,6 +497,26 @@ def anp(x):
                         (anp([QQ(1)])*x + anp([QQ( 1), QQ(0)])*y, 1)])
 
 
+def test_dmp_ext_factor_content():
+    K = QQ.algebraic_field(sqrt(2))
+    R, x, y, z = ring("x,y,z", K)
+    a = K.unit
+
+    cases = [
+        (K.one, [(x - 1, 1), (y - 1, 1)]),
+        (K(3), [(x - a, 2), (y - a, 3), (y + a, 3), (z - 1, 4)]),
+        (a, [(y - a, 2), (z - 1, 3)]),
+        (K(2), [(z - a, 2), (z + a, 2)]),
+    ]
+    for coeff, factors in cases:
+        f = R(coeff)
+        for factor, multiplicity in factors:
+            f *= factor**multiplicity
+        result_coeff, result_factors = R.dmp_ext_factor(f)
+        assert result_coeff == coeff
+        assert dict(result_factors) == dict(factors)
+
+
