+def test_Poly_clear_denoms_cancellation():
+    # Keep an unexpanded coefficient: multiplication by its denominator
+    # exposes the zero, which must then be removed from the dense polynomial.
+    for shift in (1, 2):
+        zero = ((a + shift)**2 - a**2 - 2*a*shift - shift**2)/(a + 3)
+        for gens in ((x,), (x, y), (x, y, z)):
+            n = len(gens)
+            for convert in (False, True):
+                f = Poly.from_dict({(0,)*n: zero}, *gens, domain=EX)
+                denominator, cleared = f.clear_denoms(convert=convert)
+                expected = Poly(0, *gens, domain=EX)
+                assert cleared == expected
+                assert cleared.is_zero
+                assert cleared.terms_gcd() == ((0,)*n, expected)
+                assert cleared.primitive() == (0, expected)
+                assert cancel(denominator*f.as_expr() - cleared.as_expr()) == 0
+
+                # Leading and interior cancellations must preserve the other
+                # coefficients and their monomials, including symbolic ones.
+                f = Poly.from_dict({(3,)*n: zero, (2,)*n: 2/(a + 3),
+                                   (1,)*n: zero, (0,)*n: b/(a + 3)},
+                                  *gens, domain=EX)
+                denominator, cleared = f.clear_denoms(convert=convert)
+                expected = Poly.from_dict({(2,)*n: 2, (0,)*n: b},
+                                          *gens, domain=EX)
+                assert denominator == a + 3
+                assert cleared == expected
+                assert not cleared.is_zero
+                assert cleared.terms_gcd() == ((0,)*n, expected)
+                assert cleared.primitive() == (1, expected)
+                assert cancel(denominator*f.as_expr() - cleared.as_expr()) == 0
+
+
