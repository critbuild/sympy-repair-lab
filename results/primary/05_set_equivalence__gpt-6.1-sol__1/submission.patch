+def test_ProductSet_FiniteSet_subset_and_equality():
+    a = FiniteSet(1, 2)
+    product = ProductSet(a, a)
+    listed = FiniteSet((1, 1), (1, 2), (2, 1), (2, 2))
+    missing = FiniteSet((1, 1), (1, 2), (2, 1))
+    extra = listed | FiniteSet((3, 3))
+
+    assert product.is_subset(listed) is True
+    assert listed.is_subset(product) is True
+    assert product.is_subset(missing) is False
+    assert missing.is_subset(product) is True
+    assert product.is_subset(extra) is True
+    assert extra.is_subset(product) is False
+
+    for lhs, rhs, expected in [(product, listed, S.true),
+                               (product, missing, S.false),
+                               (product, extra, S.false),
+                               (product, FiniteSet(1, 2), S.false),
+                               (ProductSet(S.Integers, a), listed, S.false)]:
+        for left, right in [(lhs, rhs), (rhs, lhs)]:
+            assert Eq(left, right) is expected
+            assert Eq(left, right, evaluate=False).simplify() is expected
+
+    symbolic = ProductSet(FiniteSet(x), FiniteSet(1))
+    singleton = FiniteSet((1, 1))
+    assert symbolic.is_subset(singleton) is None
+    assert singleton.is_subset(symbolic) is None
+    for lhs, rhs in [(symbolic, singleton), (singleton, symbolic)]:
+        equality = Eq(lhs, rhs)
+        assert equality.is_Equality
+        assert equality.simplify() == equality.canonical
+        assert equality.subs(x, 1) is S.true
+        assert equality.subs(x, 2) is S.false
+
+    # Symbolic elements may coincide, so structural cardinality is not enough.
+    symbolic = ProductSet(FiniteSet(1, x), FiniteSet(1))
+    assert symbolic.is_subset(singleton) is None
+    assert Eq(symbolic, singleton).subs(x, 1) is S.true
+
+    nested = ProductSet(ProductSet(a), a)
+    assert Eq(nested, FiniteSet(((1,), 1), ((1,), 2),
+                               ((2,), 1), ((2,), 2))) is S.true
+    assert Eq(ProductSet(Range(2), a),
+              FiniteSet((0, 1), (0, 2), (1, 1), (1, 2))) is S.true
+    n, m = symbols('n m', integer=True)
+    assert ProductSet(Range(n, m)).is_subset(FiniteSet((1,))) is None
+
