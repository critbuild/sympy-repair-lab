+def test_simplify_set_equality():
+    # Membership is undecidable; set subtraction cannot decide equality.
+    for lhs, rhs in [(FiniteSet(x), FiniteSet(1)),
+                     (FiniteSet(x), FiniteSet(y))]:
+        for left, right in [(lhs, rhs), (rhs, lhs)]:
+            for relation in (Eq, Ne):
+                equality = relation(left, right)
+                assert equality.simplify() == equality.canonical
+
+    # Unevaluated relations should still be evaluated when simplified.
+    lhs = FiniteSet(1)
+    assert Eq(lhs, lhs, evaluate=False).simplify() is S.true
+    assert Eq(lhs, FiniteSet(2), evaluate=False).simplify() is S.false
+
