+def test_set_equality_simplify():
+    product = ProductSet(FiniteSet(1, 2), FiniteSet(1, 2))
+    listed = FiniteSet((1, 1), (1, 2), (2, 1), (2, 2))
+    cases = [
+        (product, listed, S.true),
+        (product, listed - FiniteSet((2, 2)), S.false),
+        (product, listed | FiniteSet((3, 3)), S.false),
+        (product, FiniteSet(1, 2), S.false),
+        (product, S.EmptySet, S.false),
+        (product, Interval(1, 2), S.false),
+    ]
+    for lhs, rhs, expected in cases:
+        for a, b in [(lhs, rhs), (rhs, lhs)]:
+            assert Eq(a, b) is expected
+            assert Eq(a, b, evaluate=False).simplify() is expected
+            assert Ne(a, b, evaluate=False).simplify() is ~expected
+
+    for lhs, rhs in [
+        (ProductSet(FiniteSet(x), FiniteSet(1)), FiniteSet((1, 1))),
+        (FiniteSet(x), FiniteSet(1)),
+        (FiniteSet(x, y), FiniteSet(x)),
+    ]:
+        for a, b in [(lhs, rhs), (rhs, lhs)]:
+            eq = Eq(a, b).simplify()
+            assert isinstance(eq, Equality)
+            assert eq.subs(x, 1).subs(y, 1) is S.true
+            assert isinstance(Ne(a, b).simplify(), Unequality)
+
