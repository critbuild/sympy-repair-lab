@@ -726,6 +726,39 @@ def test_is_subset():
     assert Range(5).is_subset(Interval(0, 4, right_open=True)) is False
 
 
+def test_finite_product_subset():
+    product = ProductSet(FiniteSet(1, 2), FiniteSet(1, 2))
+    listed = FiniteSet((1, 1), (1, 2), (2, 1), (2, 2))
+    assert product.is_subset(listed) is True
+    assert listed.is_subset(product) is True
+    missing = listed - FiniteSet((2, 2))
+    extra = listed | FiniteSet((3, 3))
+    assert product.is_subset(missing) is False
+    assert missing.is_subset(product) is True
+    assert product.is_subset(extra) is True
+    assert extra.is_subset(product) is False
+    assert product.is_subset(Interval(0, 3)) is False
+    assert product.intersect(listed) == listed
+    assert listed - product == S.EmptySet
+
+    symbolic = ProductSet(FiniteSet(x), FiniteSet(1))
+    point = FiniteSet((y, 1))
+    assert symbolic.is_subset(point) is None
+    assert point.is_subset(symbolic) is None
+    assert symbolic.is_subset(FiniteSet((x, 1))) is True
+    assert symbolic.is_subset(FiniteSet((y, 2))) is False
+    # An unknown match must not hide a definite counterexample.
+    assert ProductSet(FiniteSet(x, 2), FiniteSet(1)).is_subset(
+        FiniteSet((1, 1))) is False
+    assert ProductSet(Range(2), FiniteSet(1)).is_subset(
+        FiniteSet((0, 1), (1, 1))) is True
+    assert ProductSet(ProductSet(FiniteSet(1)), FiniteSet(2)).is_subset(
+        FiniteSet(((1,), 2))) is True
+    size = Symbol('size', integer=True, positive=True)
+    assert ProductSet(Range(size), FiniteSet(1)).is_subset(
+        FiniteSet((0, 1))) is None
+
+
