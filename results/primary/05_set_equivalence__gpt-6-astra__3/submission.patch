+def test_simplify_set_equality():
+    product = ProductSet(FiniteSet(1, 2), FiniteSet(1, 2))
+    listed = FiniteSet((1, 1), (1, 2), (2, 1), (2, 2))
+    for lhs, rhs, expected in [
+            (product, listed, S.true),
+            (product, FiniteSet((1, 1)), S.false),
+            (product, Interval(1, 2), S.false)]:
+        for a, b in [(lhs, rhs), (rhs, lhs)]:
+            assert Eq(a, b, evaluate=False).simplify() is expected
+            assert Ne(a, b, evaluate=False).simplify() is ~expected
+
+    for lhs, rhs in [
+            (ProductSet(FiniteSet(x), FiniteSet(1)), FiniteSet((1, 1))),
+            (FiniteSet(x), FiniteSet(1)),
+            (FiniteSet(x, y), FiniteSet(1))]:
+        for a, b in [(lhs, rhs), (rhs, lhs)]:
+            eq = Eq(a, b).simplify()
+            assert eq == Eq(a, b).canonical
+            assert Ne(a, b).simplify() == Ne(a, b).canonical
+            assert eq.subs({x: 1, y: 1}) is S.true
+            assert eq.subs({x: 2, y: 2}) is S.false
