+def test_finite_product_subset_and_equality():
+    product = ProductSet(FiniteSet(1, 2), FiniteSet(1, 2))
+    listed = FiniteSet((1, 1), (1, 2), (2, 1), (2, 2))
+    smaller = FiniteSet((1, 1), (1, 2), (2, 1))
+    larger = listed | FiniteSet((3, 3))
+
+    assert product.is_subset(listed) is True
+    assert listed.is_subset(product) is True
+    assert product.is_subset(smaller) is False
+    assert smaller.is_subset(product) is True
+    assert product.is_subset(larger) is True
+    assert larger.is_subset(product) is False
+    for other, expected in [(listed, S.true), (smaller, S.false),
+                            (larger, S.false), (FiniteSet(1, 2), S.false),
+                            (FiniteSet((1, 1, 1)), S.false),
+                            (S.EmptySet, S.false)]:
+        assert Eq(product, other) is expected
+        assert Eq(other, product) is expected
+
+    symbolic = ProductSet(FiniteSet(x), FiniteSet(1))
+    singleton = FiniteSet((1, 1))
+    assert symbolic.is_subset(singleton) is None
+    assert singleton.is_subset(symbolic) is None
+    assert unchanged(Eq, symbolic, singleton)
+    assert unchanged(Eq, singleton, symbolic)
+    # An undecidable membership must not mask a definite counterexample.
+    assert ProductSet(FiniteSet(x, 2), FiniteSet(1)).is_subset(singleton) is False
+    assert Eq(ProductSet(FiniteSet(x, 2), FiniteSet(1)), singleton) is S.false
+
+    nested = ProductSet(ProductSet(FiniteSet(1), FiniteSet(2)), FiniteSet(3))
+    assert Eq(nested, FiniteSet(((1, 2), 3))) is S.true
+    assert Eq(ProductSet(Range(2), FiniteSet(1)),
+              FiniteSet((0, 1), (1, 1))) is S.true
+    assert ProductSet(S.Integers, S.Integers).is_subset(listed) is False
+
+    n = Symbol('n', integer=True, positive=True)
+    symbolic_range = ProductSet(Range(n), FiniteSet(1))
+    assert symbolic_range.is_subset(FiniteSet((0, 1))) is None
+    assert isinstance(Eq(symbolic_range, FiniteSet((0, 1))).simplify(), Eq)
+
+    assert product & listed == listed
+    assert product - listed == S.EmptySet
+    assert listed - product == S.EmptySet
+    assert product | listed == product
+
