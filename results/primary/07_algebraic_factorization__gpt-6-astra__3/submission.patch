+def test_factor_multivariate_extension_content():
+    cases = [
+        (1, [x - 1, y - 1]),
+        (1, [x - I, y + I]),
+        (1, [x - I*y, z - I*t]),
+        (1, [x - y, y - z, z - 1]),
+        (36, [x - S.Half, y - Rational(2, 3)]),
+        (1 + I, [x - I, y + I]),
+        (1, [x - 1, y - I, y + I]),
+    ]
+    for coeff, factors in cases:
+        expected = coeff*Mul(*factors)
+        expression = expand(expected)
+        result = factor(expression, extension=[I])
+        assert result == expected
+        assert expand(result) == expression
+        actual_coeff, actual_factors = factor_list(expression, extension=[I])
+        assert actual_coeff == coeff
+        assert set(actual_factors) == set((f, 1) for f in factors)
+
+    expression = expand(6*(2*x - 1)*(3*y - 2))
+    assert factor(expression) == Mul(6, 2*x - 1, 3*y - 2)
+    assert factor(expand(3*(x - I)**2*(x + I)**3), extension=[I]) == \
+        3*(x - I)**2*(x + I)**3
