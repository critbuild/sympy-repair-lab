index 7bcd935..5e089e0 100644
--- a/sympy/polys/tests/test_factortools.py
+++ b/sympy/polys/tests/test_factortools.py
@@ -497,6 +497,27 @@ def anp(x):
                         (anp([QQ(1)])*x + anp([QQ( 1), QQ(0)])*y, 1)])
 
 
+def test_dmp_ext_factor_content():
+    K = QQ.algebraic_field(I)
+    R, x, y, z = ring("x,y,z", K)
+    a = K.unit
+
+    # Include polynomials independent of the main variable and content
+    # that itself has polynomial content in the remaining variables.
+    for factors in ([y - a], [y - a, z + a],
+                    [x - a*y, y - a, z + a]):
+        f = R(2 + a)
+        for g in factors:
+            f *= g
+        coeff, result = R.dmp_ext_factor(f)
+        assert coeff == 2 + a
+        assert set(result) == set((g, 1) for g in factors)
+        reconstructed = R(coeff)
+        for g, k in result:
+            reconstructed *= g**k
+        assert reconstructed == f
+
+
