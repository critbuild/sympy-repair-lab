+def test_simplify_set_equality():
+    for lhs, rhs in [(FiniteSet(x), FiniteSet(y)),
+                     (ProductSet(FiniteSet(x)), FiniteSet((y,))),
+                     (ProductSet(Interval(0, x)), ProductSet(Interval(0, y)))]:
+        for a, b in [(lhs, rhs), (rhs, lhs)]:
+            assert Eq(a, b).simplify() == Eq(a, b).canonical
+            assert Ne(a, b).simplify() == Ne(a, b).canonical
+
+    # Unevaluated equalities are evaluated without arithmetic on the sets.
+    lhs = ProductSet(FiniteSet(1))
+    rhs = FiniteSet((1,))
+    assert Eq(lhs, rhs, evaluate=False).simplify() is S.true
+    assert Ne(lhs, rhs, evaluate=False).simplify() is S.false
+
+    # Set comparison can also evaluate to a compound Boolean expression.
+    lhs, rhs = Interval(x, y), Interval(z, t)
+    expected = And(Eq(x, z), Eq(y, t))
+    assert Eq(lhs, rhs, evaluate=False).simplify() == expected
+    assert Ne(lhs, rhs, evaluate=False).simplify() == ~expected
