+def test_ProductSet_finite_subset():
+    product = ProductSet(FiniteSet(1, 2), FiniteSet(1, 2))
+    listed = FiniteSet((1, 1), (1, 2), (2, 1), (2, 2))
+    missing = listed - FiniteSet((2, 2))
+    extra = listed | FiniteSet((3, 3))
+    assert product.is_subset(listed) is True
+    assert listed.is_subset(product) is True
+    assert product.is_subset(missing) is False
+    assert missing.is_subset(product) is True
+    assert product.is_subset(extra) is True
+    assert extra.is_subset(product) is False
+    assert product.is_subset(Interval(0, 3)) is False
+    assert ProductSet(Range(2), FiniteSet(1)).is_subset(
+        FiniteSet((0, 1), (1, 1))) is True
+
+    symbolic = ProductSet(FiniteSet(x), FiniteSet(1))
+    assert symbolic.is_subset(FiniteSet((y, 1))) is None
+    assert FiniteSet((y, 1)).is_subset(symbolic) is None
+    assert symbolic.is_subset(FiniteSet((x + 1, 1))) is False
+    assert symbolic.is_subset(ProductSet(Interval(0, 1), FiniteSet(1))) is None
+
+    # Ordinary operations continue to use the same tuple elements.
+    assert product.intersect(listed) == listed
+    assert product.intersect(missing) == missing
+    assert product - listed is S.EmptySet
+    assert listed - product is S.EmptySet
+    assert product | listed == product
+
