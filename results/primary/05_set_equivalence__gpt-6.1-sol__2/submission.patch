+def test_Eq_ProductSet_FiniteSet():
+    product = ProductSet(FiniteSet(1, 2), FiniteSet(1, 2))
+    listed = FiniteSet((1, 1), (1, 2), (2, 1), (2, 2))
+    unequal = [listed - FiniteSet((2, 2)), listed | FiniteSet((3, 3)),
+        FiniteSet((1, 1), (1, 2), (2, 1), (3, 3)), FiniteSet(1, 2)]
+    for lhs, rhs in [(product, listed), (listed, product)]:
+        assert Eq(lhs, rhs) is S.true
+        assert Eq(lhs, rhs, evaluate=False).simplify() is S.true
+    for other in unequal:
+        for lhs, rhs in [(product, other), (other, product)]:
+            assert Eq(lhs, rhs) is S.false
+            assert Eq(lhs, rhs, evaluate=False).simplify() is S.false
+
+    symbolic = ProductSet(FiniteSet(x), FiniteSet(1))
+    for lhs, rhs in [(symbolic, FiniteSet((y, 1))),
+                     (FiniteSet((y, 1)), symbolic)]:
+        eq = Eq(lhs, rhs)
+        assert eq.is_Equality
+        assert eq.simplify() == eq.canonical
+        assert eq.subs(y, x) is S.true
+        assert eq.subs(y, x + 1) is S.false
