+def test_factor_extension_multivariate_content():
+    cases = [
+        ((x - 1)*(y - 1), (x - 1)*(y - 1)),
+        ((x - I)*(y - I), (x - I)*(y - I)),
+        (6*(2*x - 1)*(3*y - 2), Mul(36, x - S.Half, y - Rational(2, 3))),
+        ((2 + I)*(x - I*y)*(z - I), (2 + I)*(x - I*y)*(z - I)),
+        ((x - y)*(x + y)*(z**2 + 1),
+         (x - y)*(x + y)*(z - I)*(z + I)),
+    ]
+    for expression, expected in cases:
+        result = factor(expand(expression), extension=[I])
+        assert result == expected
+        assert expand(result - expression) == 0
+
+    # Rational factorization and univariate multiplicities use their own paths.
+    assert factor(expand(6*(2*x - 1)*(3*y - 2))) == Mul(6, 2*x - 1, 3*y - 2)
+    assert factor(expand((x - I)**3*(x + I)**2), extension=[I]) == \
+        (x - I)**3*(x + I)**2
+
+
