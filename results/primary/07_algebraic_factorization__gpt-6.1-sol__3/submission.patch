--- a/sympy/polys/tests/test_factortools.py
+++ b/sympy/polys/tests/test_factortools.py
@@ -497,6 +497,32 @@ def anp(x):
                         (anp([QQ(1)])*x + anp([QQ( 1), QQ(0)])*y, 1)])
 
 
+def test_dmp_ext_factor_content():
+    K = QQ.algebraic_field(I)
+    R, x, y, z = ring("x,y,z", K)
+    i = K.unit
+
+    cases = [
+        (K.one, [x - 1, y - 1]),
+        (K.one, [x - i, y - i]),
+        (K(6), [x - QQ(1, 2), y - QQ(2, 3)]),
+        (K(2) + i, [x - i*y, z - i]),
+        (K.one, [y - i, z + i]),
+        (K.one, [x - y, x + y, z - i, z + i]),
+    ]
+    for coeff, expected in cases:
+        f = R.ground_new(coeff)
+        for g in expected:
+            f *= g
+        actual_coeff, factors = R.dmp_ext_factor(f)
+        assert actual_coeff == coeff
+        assert dict(factors) == dict((g, 1) for g in expected)
+        product = R.ground_new(actual_coeff)
+        for g, k in factors:
+            product *= g**k
+        assert product == f
+
+
