+def test_determinant_symbolic_zero_pivots():
+    for n in range(4, 7):
+        M = Matrix(n, n, lambda j, i: i + a*j)
+        assert M.det() == 0
+        assert M.det(method='bareiss') == 0
+        assert M.det(method='berkowitz').expand() == 0
+
+    # An identically zero first column must not provide a pivot.
+    zero = sin(x)**2 + cos(x)**2 - 1
+    M = eye(4)
+    M[0, 0] = zero
+    assert M.det() == 0
+
+    # Skip the symbolic zero and swap rows, retaining the determinant sign.
+    M[0, 1] = 1
+    M[1, 0] = x
+    M[1, 1] = 0
+    for method in ('bareiss', 'berkowitz', 'lu'):
+        assert M.det(method=method).simplify() == -x
+
+    # Unknown symbolic pivots are still usable for a nonsingular matrix.
+    assert diag(x, y, z, 1).det() == x*y*z
+
