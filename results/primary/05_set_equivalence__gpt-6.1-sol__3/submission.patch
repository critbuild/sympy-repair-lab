+def test_Eq_ProductSet_FiniteSet():
+    product = ProductSet(FiniteSet(1, 2), FiniteSet(1, 2))
+    listed = FiniteSet((1, 1), (1, 2), (2, 1), (2, 2))
+    missing = FiniteSet((1, 1), (1, 2), (2, 1))
+    extra = listed | FiniteSet((3, 3))
+    for other, expected in [(listed, S.true), (missing, S.false),
+                            (extra, S.false), (FiniteSet(1, 2), S.false),
+                            (S.EmptySet, S.false)]:
+        for lhs, rhs in [(product, other), (other, product)]:
+            assert Eq(lhs, rhs) is expected
+            assert Eq(lhs, rhs, evaluate=False).simplify() is expected
+
+    symbolic = ProductSet(FiniteSet(x), FiniteSet(1))
+    for lhs, rhs in [(symbolic, FiniteSet((y, 1))),
+                     (FiniteSet((y, 1)), symbolic)]:
+        assert isinstance(Eq(lhs, rhs), Eq)
+        assert Eq(lhs, rhs).subs(y, x) is S.true
+        assert Eq(lhs, rhs).subs(y, x + 1) is S.false
+
+    # An undecidable membership must not hide a known nonmember.
+    for lhs, rhs in [(ProductSet(FiniteSet(1, 2)), FiniteSet((x,), (3,))),
+                     (FiniteSet((x,), (3,)), ProductSet(FiniteSet(1, 2)))]:
+        assert Eq(lhs, rhs) is S.false
+
