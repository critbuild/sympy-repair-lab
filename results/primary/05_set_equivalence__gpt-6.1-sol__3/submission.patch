+def test_simplify_set_equality():
+    # A set difference is not an arithmetic difference to compare with zero.
+    pairs = [
+        (FiniteSet(x), FiniteSet(y)),
+        (FiniteSet(x), FiniteSet(1)),
+        (ProductSet(FiniteSet(x)), FiniteSet((1,))),
+        (ProductSet(FiniteSet(x), FiniteSet(1)), FiniteSet((y, 1))),
+        (ProductSet(Interval(0, 1)), ProductSet(Interval(0, x))),
+    ]
+    for lhs, rhs in pairs:
+        for a, b in [(lhs, rhs), (rhs, lhs)]:
+            for relation in (Eq, Ne):
+                eq = relation(a, b)
+                assert eq.simplify() == eq.canonical
+
+    # Rebuilding an unevaluated relation can give a definitive result.
+    lhs = ProductSet(FiniteSet(1))
+    assert Eq(lhs, FiniteSet((1,)), evaluate=False).simplify() is S.true
+    assert Ne(lhs, FiniteSet((1,)), evaluate=False).simplify() is S.false
+
