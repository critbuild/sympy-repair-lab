index 7bcd935..a5558cd 100644
--- a/sympy/polys/tests/test_factortools.py
+++ b/sympy/polys/tests/test_factortools.py
@@ -497,6 +497,30 @@ def anp(x):
                         (anp([QQ(1)])*x + anp([QQ( 1), QQ(0)])*y, 1)])
 
 
+def test_dmp_ext_factor_content():
+    K = QQ.algebraic_field(I)
+    R, x, y, z = ring("x,y,z", K)
+    i = K.unit
+
+    for coeff, factors in [
+        (K.one, [x - 1, y - 1]),
+        (K.one, [x - i*y, z - i]),
+        (K.one, [y - 1, z - i]),
+        (K.one, [z - i]),
+        (K(2) + i, [x + K(QQ(3, 2))*y, y - i, z + 2*i]),
+    ]:
+        f = R.ground_new(coeff)
+        for g in factors:
+            f *= g
+        c, result = R.dmp_ext_factor(f)
+        assert c == coeff
+        assert dict(result) == dict((g, 1) for g in factors)
+        product = R.ground_new(c)
+        for g, k in result:
+            product *= g**k
+        assert product == f
+
+
