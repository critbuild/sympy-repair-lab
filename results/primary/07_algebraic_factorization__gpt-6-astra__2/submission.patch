+def test_factor_extension_multivariate_content():
+    cases = [
+        (x - 1)*(y - 1),
+        (x - I)*(y + I),
+        (x - I*y)*(y - I),
+        (x - y)*(y - z)*(z - I),
+        (x - I)*(x + I)*(y - I)*(y + I),
+        Mul(18, x - S.Half, y - Rational(1, 3)),
+        (1 + I)*(x - I)*(y + I),
+    ]
+    for expected in cases:
+        expression = expand(expected)
+        result = factor(expression, extension=[I])
+        assert result == expected
+        assert expand(result) == expression
+
+    # The univariate multiplicity and rational-domain paths are unchanged.
+    expected = 3*(x - I)**2*(x + I)**3
+    assert factor(expand(expected), extension=[I]) == expected
+    expected = Mul(3, 2*x - 1, 3*y - 1)
+    assert factor(expand(expected)) == expected
+
