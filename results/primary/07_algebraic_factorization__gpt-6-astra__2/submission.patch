+def test_dmp_ext_factor_content():
+    K = QQ.algebraic_field(I)
+    R, x, y, z = ring("x,y,z", K)
+    a = K.unit
+    cases = [
+        (K.one, [x - 1, y - 1]),
+        (K.one, [y - a, z + a]),
+        (K.one, [x - y, y - z, z - a]),
+        (K.one, [x - a*y, y - a, y + a]),
+        (K(6), [x - K(QQ(1, 2)), y - K(QQ(1, 3))]),
+        (K.one + a, [x - a, y + a]),
+    ]
+    for coeff, factors in cases:
+        f = R.ground_new(coeff)
+        for g in factors:
+            f *= g
+        result_coeff, result_factors = R.dmp_ext_factor(f)
+        assert result_coeff == coeff
+        assert dict(result_factors) == dict((g, 1) for g in factors)
+        result = R.ground_new(result_coeff)
+        for g, k in result_factors:
+            result *= g**k
+        assert result == f
+
+
