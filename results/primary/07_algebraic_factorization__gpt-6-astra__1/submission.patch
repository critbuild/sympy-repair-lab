+def test_factor_extension_multivariate_content():
+    cases = [
+        (1, [x - 1, y - 1]),
+        (-3, [x - I, y + I]),
+        (S(2)/3, [x - I*y, y - I]),
+        (1 + I, [x - I, y + I, z - 1]),
+        (1, [x - I*y, z - I*t]),
+        (18*I, [x - I/2, y + 2*I/3]),
+        (1, [x - I*y, x + I*y, y - 1]),
+    ]
+    for coeff, factors in cases:
+        expected = coeff*Mul(*factors)
+        expression = expand(expected)
+        result = factor(expression, extension=[I])
+        assert result == expected
+        assert expand(result) == expression
+        c, result_factors = factor_list(expression, extension=[I])
+        assert c == coeff
