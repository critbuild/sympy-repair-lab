+def test_simplify_set_equality():
+    product = ProductSet(FiniteSet(1, 2), FiniteSet(1, 2))
+    listed = FiniteSet((1, 1), (1, 2), (2, 1), (2, 2))
+    cases = [
+        (product, listed, S.true),
+        (product, FiniteSet((1, 1), (1, 2), (2, 1)), S.false),
+        (product, listed | FiniteSet((3, 3)), S.false),
+        (product, FiniteSet((1, 1), (1, 2), (2, 1), (3, 3)), S.false),
+        (product, Interval(1, 2), S.false),
+    ]
+    for lhs, rhs, expected in cases:
+        for a, b in [(lhs, rhs), (rhs, lhs)]:
+            assert Eq(a, b) is expected
+            assert Eq(a, b, evaluate=False).simplify() is expected
+
+    # Unknown membership must remain unknown, including after simplification.
+    cases = [
+        (ProductSet(FiniteSet(x), FiniteSet(1)), FiniteSet((y, 1))),
+        (ProductSet(FiniteSet(x), FiniteSet(1)), FiniteSet((1, 1))),
+        (FiniteSet(x), FiniteSet(y)),
+        (ProductSet(Interval(0, x), Interval(0, 1)),
+         ProductSet(Interval(0, y), Interval(0, 1))),
+    ]
+    for lhs, rhs in cases:
+        for a, b in [(lhs, rhs), (rhs, lhs)]:
+            result = Eq(a, b).simplify()
+            assert isinstance(result, Equality)
+            assert result == Eq(a, b).canonical
+
+
