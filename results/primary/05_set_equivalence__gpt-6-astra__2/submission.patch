+def test_finite_product_subset():
+    product = ProductSet(FiniteSet(1, 2), FiniteSet(1, 2))
+    listed = FiniteSet((1, 1), (1, 2), (2, 1), (2, 2))
+    smaller = FiniteSet((1, 1), (1, 2), (2, 1))
+    larger = listed | FiniteSet((3, 3))
+    assert product.is_subset(listed) is True
+    assert listed.is_subset(product) is True
+    assert product.is_subset(smaller) is False
+    assert smaller.is_subset(product) is True
+    assert product.is_subset(larger) is True
+    assert larger.is_subset(product) is False
+
+    symbolic = ProductSet(FiniteSet(x), FiniteSet(1))
+    assert symbolic.is_subset(FiniteSet((y, 1))) is None
+    assert FiniteSet((y, 1)).is_subset(symbolic) is None
+    assert symbolic.is_subset(FiniteSet((y, 2))) is False
+    assert FiniteSet((y, 2)).is_subset(symbolic) is False
+    # An unknown membership must not hide a definite counterexample.
+    assert ProductSet(FiniteSet(x), FiniteSet(1, 2)).is_subset(
+        FiniteSet((y, 1))) is False
+
+    nested = ProductSet(product, FiniteSet(0))
+    assert nested.is_subset(FiniteSet(*nested)) is True
+    assert ProductSet(S.Integers, S.Integers).is_subset(listed) is False
+
