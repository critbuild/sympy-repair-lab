+def test_Poly_clear_denoms_expression_cancellation():
+    c = ((a + 1)**2 - a**2 - 2*a - 1)/2
+    for gens in ((x,), (x, y), (x, y, z)):
+        zero = Poly(0, *gens, domain='EX')
+        # Retain an unexpanded coefficient until denominator clearing.
+        f = Poly.from_dict({(0,)*len(gens): c}, *gens, domain='EX')
+        for convert in (False, True):
+            denominator, cleared = f.clear_denoms(convert=convert)
+            assert denominator == 2
+            assert cleared == zero
+            assert cleared.is_zero
+            assert cleared.terms_gcd() == ((0,)*len(gens), zero)
+            assert cleared.primitive() == (0, zero)
+            assert expand(denominator*f.as_expr() - cleared.as_expr()) == 0
+
+            # Remove a cancelled leading coefficient while keeping symbolic,
+            # nonzero and trailing zero coefficients in their proper places.
+            coeffs = {(3,)*len(gens): c, (2,)*len(gens): a/3,
+                      (1,)*len(gens): Rational(2, 5)}
+            f_mixed = Poly.from_dict(coeffs, *gens, domain='EX')
+            denominator, cleared = f_mixed.clear_denoms(convert=convert)
+            monomial = Mul(*gens)
+            assert denominator == 30
+            assert cleared == Poly(10*a*monomial**2 + 12*monomial,
+                                   *gens, domain='EX')
+            assert expand(denominator*f_mixed.as_expr() - cleared.as_expr()) == 0
+
+
