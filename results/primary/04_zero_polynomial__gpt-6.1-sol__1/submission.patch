+def test_mul_ground_expression_cancellation():
+    c = EX((x + 1)**2 - x**2 - 2*x - 1)
+    assert dup_mul_ground([c], EX(2), EX) == []
+    assert dup_mul_ground([c, EX(x), EX(0)], EX(2), EX) == [EX(2*x), EX(0)]
