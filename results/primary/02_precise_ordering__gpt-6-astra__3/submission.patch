+def test_NumberSymbol_ordering():
+    above = Rational('905502432259640373/288230376151711744')
+    below = Rational(884279719003555, 281474976710656)
+    # The dyadic endpoints are also represented exactly by these Floats.
+    pairs = [(below, pi), (pi, above),
+             (Float(below, 60), pi), (pi, Float(above, 60)),
+             (pi.evalf(), pi)]
+    # Decimal bounds much closer than the default evalf precision.
+    for constant, digits in [
+            (pi, '3.14159265358979323846264338327950288419716939937510'),
+            (E, '2.71828182845904523536028747135266249775724709369995'),
+            (GoldenRatio, '1.61803398874989484820458683436563811772030917980576'),
+            (EulerGamma, '0.57721566490153286060651209008240243104215933593992'),
+            (Catalan, '0.91596559417721901505460351493238411077414937428167')]:
+        lower = Rational(digits)
+        upper = lower + Rational(1, 10**50)
+        pairs.extend([(lower, constant), (constant, upper),
+                      (Float(lower, 60), constant),
+                      (constant, Float(upper, 60)),
+                      (S.Zero, constant), (constant, S(4)),
+                      (Float(0), constant), (constant, Float(4)),
+                      (-oo, constant), (constant, oo)])
+        assert (constant < constant) is S.false
+        assert (constant > constant) is S.false
+        assert (constant <= constant) is S.true
+        assert (constant >= constant) is S.true
+    for lower, upper in pairs:
+        assert (lower < upper) is S.true
+        assert (lower <= upper) is S.true
+        assert (lower > upper) is S.false
+        assert (lower >= upper) is S.false
+        assert (upper > lower) is S.true
+        assert (upper >= lower) is S.true
+        assert (upper < lower) is S.false
+        assert (upper <= lower) is S.false
+
+
+def test_NumberSymbol_ordering_equal_boundary():
+    from sympy.core.numbers import NumberSymbol
+
+    class ZeroConstant(NumberSymbol):
+        is_zero = True
+
+        def _as_mpf_val(self, prec):
+            return S.Zero._as_mpf_val(prec)
+
+    zero = ZeroConstant()
+    for scalar in [S.Zero, Float(0)]:
+        for lhs, rhs in [(zero, scalar), (scalar, zero)]:
+            assert (lhs < rhs) is S.false
+            assert (lhs > rhs) is S.false
+            assert (lhs <= rhs) is S.true
+            assert (lhs >= rhs) is S.true
+
+
+def test_NumberSymbol_ordering_symbolic():
+    x = Symbol('x', real=True)
+    for constant in [pi, E, GoldenRatio, EulerGamma, Catalan]:
+        for lhs, rhs in [(constant, x), (x, constant)]:
+            for relation in [Lt, Le, Gt, Ge]:
+                assert relation(lhs, rhs) == relation(lhs, rhs, evaluate=False)
+
