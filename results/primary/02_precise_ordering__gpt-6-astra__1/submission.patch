+def test_NumberSymbol_scalar_ordering():
+    r = Rational('905502432259640373/288230376151711744')
+    # Bounds much closer than the default evalf precision can distinguish.
+    lower_pi = Rational('3.14159265358979323846264338327950288419716939937510')
+    upper_pi = lower_pi + Rational(1, 10**50)
+    bounds = [
+        (pi, lower_pi, upper_pi),
+        (E, Rational('2.718281828459045235'),
+            Rational('2.718281828459045236')),
+        (GoldenRatio, Rational('1.618033988749894848'),
+            Rational('1.618033988749894849')),
+        (EulerGamma, Rational('0.577215664901532860'),
+            Rational('0.577215664901532861')),
+        (Catalan, Rational('0.915965594177219015'),
+            Rational('0.915965594177219016')),
+    ]
+    pairs = [(pi, r), (pi, Float(r, 25)), (pi.evalf(), pi),
+             (Rational(pi.evalf()), pi)]
+    for constant, lower, upper in bounds:
+        pairs.extend([(lower, constant), (constant, upper),
+                      (Float(lower, 60), constant),
+                      (constant, Float(upper, 60)),
+                      (S.Zero, constant), (constant, S(4)),
+                      (-oo, constant), (constant, oo)])
+    for lower, upper in pairs:
+        assert (lower < upper) is S.true
+        assert (lower <= upper) is S.true
+        assert (upper > lower) is S.true
+        assert (upper >= lower) is S.true
+        assert (lower > upper) is S.false
+        assert (lower >= upper) is S.false
+        assert (upper < lower) is S.false
+        assert (upper <= lower) is S.false
+
+
+def test_NumberSymbol_ordering_equality():
+    from sympy.core.numbers import NumberSymbol
+
+    # A rational-valued NumberSymbol tests the distinction between strict
+    # and inclusive reversed comparisons, which irrational constants cannot.
+    class ZeroConstant(NumberSymbol):
+        is_zero = True
+
+        def _as_mpf_val(self, prec):
+            return S.Zero._as_mpf_val(prec)
+
+        def approximation_interval(self, number_cls):
+            return (S.Zero, S.Zero)
+
+    zero = ZeroConstant()
+    for left, right in [(zero, S.Zero), (zero, Float(0)),
+                        (S.Zero, zero), (Float(0), zero)] + [
+                            (c, c) for c in
+                            (pi, E, GoldenRatio, EulerGamma, Catalan)]:
+        assert (left < right) is S.false
+        assert (left > right) is S.false
+        assert (left <= right) is S.true
+        assert (left >= right) is S.true
+
+
+def test_NumberSymbol_symbolic_ordering():
+    x = Symbol('x', real=True)
+    for constant in (pi, E, GoldenRatio, EulerGamma, Catalan):
+        for left, right in [(constant, x), (x, constant)]:
+            assert (left < right) == Lt(left, right, evaluate=False)
+            assert (left <= right) == Le(left, right, evaluate=False)
+            assert (left > right) == Gt(left, right, evaluate=False)
+            assert (left >= right) == Ge(left, right, evaluate=False)
+
+
