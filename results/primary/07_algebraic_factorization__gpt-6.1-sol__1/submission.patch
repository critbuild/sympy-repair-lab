+def test_factor_multivariate_extension_content():
+    cases = [
+        (1, [x - 1, y - 1]),
+        (3, [x - I, y + I]),
+        (2 + I, [x - I*y, z - I*t]),
+        (Rational(2, 3), [x + I/2, y - I/3, z + 1]),
+        (6, [x - S.Half, y - Rational(1, 3)]),
+        (1, [x - I*y, x + I*y, z - I, z + I]),
+    ]
+    for coeff, factors in cases:
+        expression = expand(coeff*Mul(*factors))
+        actual_coeff, actual_factors = factor_list(expression, extension=[I])
+        assert actual_coeff == coeff
+        assert set(actual_factors) == set((f, 1) for f in factors)
+        result = factor(expression, extension=[I])
+        assert expand(result - expression) == 0
+        assert result == coeff*Mul(*factors)
+
+    # The univariate multiplicity path and rational factorization still apply.
+    expression = expand(3*(x - I)**2*(x + I)**3)
+    assert factor(expression, extension=[I]) == 3*(x - I)**2*(x + I)**3
+    expression = expand(6*(x - 1)*(y - 1))
+    assert factor_list(expression) == (6, [(y - 1, 1), (x - 1, 1)])
+    assert expand(factor(expression)) == expression
+
+
