@@ -497,6 +497,29 @@ def anp(x):
                         (anp([QQ(1)])*x + anp([QQ( 1), QQ(0)])*y, 1)])
 
 
+def test_dmp_ext_factor_content():
+    K = QQ.algebraic_field(I)
+    R, x, y, z = ring("x,y,z", K)
+    i = K.unit
+    cases = [
+        (K.one, [x - 1, y - 1]),
+        (K.one, [y - i, z + i]),
+        (K(2)*i, [x - i, y + K(QQ(1, 2))]),
+        (K(3), [x - i*y, z - i, z + i]),
+    ]
+    for coeff, factors in cases:
+        f = R.ground_new(coeff)
+        for g in factors:
+            f *= g
+        actual_coeff, actual_factors = R.dmp_ext_factor(f)
+        assert actual_coeff == coeff
+        assert set(actual_factors) == set((g, 1) for g in factors)
+        product = R.ground_new(actual_coeff)
+        for g, k in actual_factors:
+            product *= g**k
+        assert product == f
+
+
