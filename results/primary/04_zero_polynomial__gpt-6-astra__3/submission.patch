+def test_Poly_clear_denoms_cancellation():
+    # Denominator clearing exposes a zero that EX did not recognize on input.
+    coefficient = (a**2 - 1)/(a - 1) - a - 1
+    for gens in [(x,), (x, y), (x, y, z)]:
+        zero = Poly(0, *gens, domain=EX)
+        for convert in [False, True]:
+            original = Poly(coefficient, *gens, domain=EX)
+            denominator, cleared = original.clear_denoms(convert=convert)
+            assert cleared == zero
+            assert cleared.is_zero
+            assert cleared.rep.rep == zero.rep.rep
+            assert cleared.terms_gcd() == ((0,)*len(gens), zero)
+            assert cleared.primitive() == (0, zero)
+            assert cancel(denominator*original.as_expr() - cleared.as_expr()) == 0
+
+            # Drop leading zeros while retaining interior zeros, degrees and
+            # coefficients whose zero status is unknown.
+            tail = gens[-1]**2 + a
+            original = Poly(coefficient*x**3 + tail/2, *gens, domain=EX)
+            denominator, cleared = original.clear_denoms(convert=convert)
+            expected = Poly(expand(denominator*tail/2), *gens, domain=EX)
+            assert cleared == expected
+            assert not cleared.is_zero
+            assert cleared.degree_list() == expected.degree_list()
+            assert cancel(denominator*original.as_expr() - cleared.as_expr()) == 0
+
+
