diff --git a/sympy/core/tests/test_numbers.py b/sympy/core/tests/test_numbers.py
index a09ff11..b363c72 100644
--- a/sympy/core/tests/test_numbers.py
+++ b/sympy/core/tests/test_numbers.py
@@ -24,6 +24,57 @@ def same_and_same_prec(a, b):
     return a == b and a._prec == b._prec
 
 
+def test_equality_reflected():
+    class Box:
+        def __init__(self, value):
+            self.value = value
+
+        def __eq__(self, other):
+            return self.value == other
+
+        def __ne__(self, other):
+            return self.value != other
+
+    # Exercise Integer's override and the singleton Rational subclasses too.
+    for value in [Integer(3), S.Zero, S.One, S.NegativeOne,
+                  Rational(2, 3), S.Half, Float(1.25), pi, E]:
+        box = Box(value)
+        assert value.__eq__(box) is NotImplemented
+        assert value.__ne__(box) is NotImplemented
+        assert (box == value) is True
+        assert (value == box) is True
+        assert (box != value) is False
+        assert (value != box) is False
+        different = Box(Symbol('x'))
+        assert (value == different) is False
+        assert (value != different) is True
+        for other in [object(), None, str(value), []]:
+            assert (value == other) is False
+            assert (other == value) is False
+            assert (value != other) is True
+            assert (other != value) is True
+
+
+def test_equality_sympifiable():
+    class Convertible:
+        def __init__(self, value):
+            self.value = value
+
+        def _sympy_(self):
+            return self.value
+
+        def __eq__(self, other):
+            raise AssertionError('Sympifiable operands should be compared directly')
+
+        __ne__ = __eq__
+
+    for value in [Integer(3), Rational(2, 3), Float(1.25), pi]:
+        assert (value == Convertible(value)) is True
+        assert (value != Convertible(value)) is False
+        assert (value == Convertible(Symbol('x'))) is False
+        assert (value != Convertible(Symbol('x'))) is True
+
+
