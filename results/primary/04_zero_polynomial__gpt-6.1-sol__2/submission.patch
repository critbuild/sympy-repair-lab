+def test_Poly_clear_denoms_cancellation():
+    # Multiplication by the common denominator exposes a zero coefficient.
+    zero = a/(a + 1) - 1 + 1/(a + 1)
+    for gens in [(x,), (x, y), (x, y, z)]:
+        for convert in [False, True]:
+            for expr, result in [
+                    (zero, 0),
+                    (zero + 2/(a + 1), 2),
+                    (zero*x**2 + b*x + 1/(a + 1), b*(a + 1)*x + 1),
+                    (b/(a + 1), b)]:
+                original = Poly(expr, *gens, domain=EX)
+                denominator, cleared = original.clear_denoms(convert=convert)
+                expected = Poly(result, *gens, domain=EX)
+                assert denominator == a + 1
+                assert cancel(denominator*original.as_expr() - cleared.as_expr()) == 0
+                assert cleared == expected
+                assert cleared.is_zero == expected.is_zero
+                assert cleared.rep.rep == expected.rep.rep
+                assert cleared.terms_gcd() == expected.terms_gcd()
+                assert cleared.primitive() == expected.primitive()
+
+
