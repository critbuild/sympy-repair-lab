+def test_equality_sympifiable_operand():
+    class Convertible:
+        def __init__(self, value):
+            self.value = value
+
+        def _sympy_(self):
+            return self.value
+
+        def __eq__(self, other):
+            raise AssertionError('sympifiable operands should be compared by SymPy')
+
+        __ne__ = __eq__
+
+    for value in [Integer(3), Rational(2, 3), S.Half, Float(3), pi]:
+        other = Convertible(value)
+        assert (value == other) is True
+        assert (value != other) is False
+
+    # These singletons retain their structural, identity-based comparisons.
+    for value in [oo, -oo, nan]:
+        assert (value == value) is True
+        assert (value != value) is False
+        other = Convertible(value)
+        assert (value == other) is False
+        assert (value != other) is True
+
+
