diff --git a/sympy/core/tests/test_basic.py b/sympy/core/tests/test_basic.py
index 9d4a8fa..d0cecfd 100644
--- a/sympy/core/tests/test_basic.py
+++ b/sympy/core/tests/test_basic.py
@@ -39,6 +39,64 @@ def test_equality():
     assert not(Basic() == 0)
 
 
+def test_reflected_comparison():
+    from sympy import Integer, Rational, Float, Symbol, S
+
+    class Box:
+        def __eq__(self, other):
+            if isinstance(other, Basic):
+                return True
+            return NotImplemented
+
+        def __ne__(self, other):
+            return not self == other
+
+    class EqualityOnly:
+        def __eq__(self, other):
+            return isinstance(other, Basic)
+
+    eq_result = object()
+    ne_result = object()
+
+    class IndependentComparisons:
+        def __eq__(self, other):
+            return eq_result
+
+        def __ne__(self, other):
+            return ne_result
+
+    class Unsupported:
+        def __eq__(self, other):
+            return NotImplemented
+
+        def __ne__(self, other):
+            return NotImplemented
+
+    x = Symbol('x')
+    values = [Basic(), x, x + 1, Integer(3), S.Zero, S.One,
+              S.NegativeOne, Rational(2, 3), S.Half, Float(3),
+              S.Infinity, S.NegativeInfinity, S.NaN, S.ComplexInfinity,
+              I, pi]
+    for value in values:
+        for box in [Box(), EqualityOnly()]:
+            assert (box == value) is True
+            assert (value == box) is True
+            assert (box != value) is False
+            assert (value != box) is False
+            assert value.__eq__(box) is NotImplemented
+            assert value.__ne__(box) is NotImplemented
+
+        other = IndependentComparisons()
+        assert (value == other) is eq_result
+        assert (value != other) is ne_result
+
+        for other in [object(), Unsupported(), None, 'x', []]:
+            assert (value == other) is False
+            assert (other == value) is False
+            assert (value != other) is True
+            assert (other != value) is True
+
+
