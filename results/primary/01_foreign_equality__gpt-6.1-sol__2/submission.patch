diff --git a/sympy/core/tests/test_basic.py b/sympy/core/tests/test_basic.py
index 9d4a8fa..885fcb1 100644
--- a/sympy/core/tests/test_basic.py
+++ b/sympy/core/tests/test_basic.py
@@ -39,6 +39,61 @@ def test_equality():
     assert not(Basic() == 0)
 
 
+def test_equality_foreign_object():
+    from sympy import Symbol, Integer, Rational, Float
+
+    class Box:
+        def __eq__(self, other):
+            if isinstance(other, Basic):
+                return True
+            return NotImplemented
+
+        def __ne__(self, other):
+            return not self == other
+
+    class EqOnly:
+        def __eq__(self, other):
+            return isinstance(other, Basic)
+
+    class Declines:
+        def __eq__(self, other):
+            return NotImplemented
+
+        def __ne__(self, other):
+            return NotImplemented
+
+    class IndependentComparisons:
+        # Reflected inequality must call __ne__, not negate __eq__.
+        def __eq__(self, other):
+            return True
+
+        def __ne__(self, other):
+            return True
+
+    x = Symbol('x')
+    values = [Basic(), x, x + 1, x**2, Integer(3), S.Zero, S.One,
+              S.NegativeOne, Rational(1, 2), Float(1.5), pi,
+              S.Infinity, S.NegativeInfinity, S.NaN, S.ComplexInfinity]
+    for value in values:
+        for other in [Box(), EqOnly()]:
+            assert value.__eq__(other) is NotImplemented
+            assert value.__ne__(other) is NotImplemented
+            assert (value == other) is True
+            assert (other == value) is True
+            assert (value != other) is False
+            assert (other != value) is False
+
+        for other in [object(), Declines(), None, [], 'x']:
+            assert (value == other) is False
+            assert (other == value) is False
+            assert (value != other) is True
+            assert (other != value) is True
+
+        other = IndependentComparisons()
+        assert (value == other) is True
+        assert (value != other) is True
+
+
