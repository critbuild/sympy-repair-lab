diff --git a/sympy/core/tests/test_numbers.py b/sympy/core/tests/test_numbers.py
index a09ff11..c10196b 100644
--- a/sympy/core/tests/test_numbers.py
+++ b/sympy/core/tests/test_numbers.py
@@ -1528,6 +1528,41 @@ def test_Float_eq():
     assert Float('.12', 22) != .12
 
 
+def test_equality_sympifiable_object():
+    class Convertible:
+        def __init__(self, value):
+            self.value = value
+
+        def _sympy_(self):
+            return self.value
+
+        def __eq__(self, other):
+            return False
+
+        def __ne__(self, other):
+            return True
+
+    for value in [Integer(3), Rational(1, 2), Float(1.5), pi]:
+        other = Convertible(value)
+        # Successful conversion still determines equality before reflection.
+        assert value.__eq__(other) is True
+        assert value.__ne__(other) is False
+        assert (value == other) is True
+        assert (value != other) is False
+
+    for value, native in [(oo, float('inf')), (-oo, float('-inf')),
+                          (nan, float('nan'))]:
+        # These singletons retain their structural identity comparisons,
+        # even when the other operand can be converted to the same singleton.
+        for other in [Convertible(value), native]:
+            assert value.__eq__(other) is False
+            assert value.__ne__(other) is True
+            assert (value == other) is False
+            assert (value != other) is True
+        assert (value == value) is True
+        assert (value != value) is False
+
+
 def test_int_NumberSymbols():
     assert [int(i) for i in [pi, EulerGamma, E, GoldenRatio, Catalan]] == \
         [3, 0, 2, 1, 0]
