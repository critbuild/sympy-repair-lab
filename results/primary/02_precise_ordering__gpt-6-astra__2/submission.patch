+def test_NumberSymbol_ordering():
+    def check_order(lower, upper):
+        assert (lower < upper) is S.true
+        assert (lower <= upper) is S.true
+        assert (lower > upper) is S.false
+        assert (lower >= upper) is S.false
+        assert (upper > lower) is S.true
+        assert (upper >= lower) is S.true
+        assert (upper < lower) is S.false
+        assert (upper <= lower) is S.false
+
+    # These values straddle pi but round to the same default-precision Float.
+    r = Rational('905502432259640373/288230376151711744')
+    below = Rational('3.1415926535897932')
+    for lower, upper in [(below, r),
+            (Rational('3.14159265358979323846264338327950288419716939937510'),
+             Rational('3.14159265358979323846264338327950288419716939937511'))]:
+        check_order(lower, pi)
+        check_order(pi, upper)
+        check_order(Float(lower, 60), pi)
+        check_order(pi, Float(upper, 60))
+    check_order(pi.evalf(), pi)
+    assert r != pi
+    assert pi != r
+
+    for constant, lower, upper in [
+            (pi, '3.1415926535', '3.1415926536'),
+            (E, '2.7182818284', '2.7182818285'),
+            (GoldenRatio, '1.6180339887', '1.6180339888'),
+            (EulerGamma, '0.5772156649', '0.5772156650'),
+            (Catalan, '0.9159655941', '0.9159655942')]:
+        for cls in (Rational, Float):
+            check_order(cls(lower), constant)
+            check_order(constant, cls(upper))
+        check_order(S.Zero, constant)
+        check_order(constant, Integer(4))
+        for infinity in (oo, Float('inf')):
+            check_order(constant, infinity)
+            check_order(-infinity, constant)
+        assert (constant < constant) is S.false
+        assert (constant > constant) is S.false
+        assert (constant <= constant) is S.true
+        assert (constant >= constant) is S.true
+        x = Symbol('x', real=True)
+        for relation in (Lt, Le, Gt, Ge):
+            assert relation(constant, x) == relation(constant, x, evaluate=False)
+            assert relation(x, constant) == relation(x, constant, evaluate=False)
+
+
+def test_NumberSymbol_ordering_equal_scalar():
+    from sympy.core.numbers import NumberSymbol
+
+    class ZeroConstant(NumberSymbol):
+        is_zero = True
+
+        def _as_mpf_val(self, prec):
+            return S.Zero._as_mpf_val(prec)
+
+    constant = ZeroConstant()
+    # Numeric equality must retain strictness when reflecting an operator.
+    for scalar in (S.Zero, Float('0.0')):
+        for lhs, rhs in [(constant, scalar), (scalar, constant)]:
+            assert (lhs < rhs) is S.false
+            assert (lhs > rhs) is S.false
+            assert (lhs <= rhs) is S.true
+            assert (lhs >= rhs) is S.true
+
+
