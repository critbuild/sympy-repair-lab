+def test_mul_ground_normalization():
+    # Multiplication in EX can expose a previously unevaluated zero.
+    c = EX(((x + 1)**2 - x**2 - 2*x - 1)/(x + 2))
+    factor = EX(x + 2)
+    assert dup_mul_ground([c], factor, EX) == []
+    assert dup_mul_ground([c, EX(1), c], factor, EX) == [factor, EX.zero]
+    assert dmp_mul_ground([[c], [c]], factor, 1, EX) == [[]]
+    assert dmp_mul_ground([[c], [c, EX(1)]], factor, 1, EX) == [[factor]]
+    assert dmp_mul_ground([[[c]], [[c]]], factor, 2, EX) == [[[]]]
+    assert dmp_mul_ground([[ZZ(1)], [ZZ(2)]], ZZ.zero, 1, ZZ) == [[]]
+
