+def test_Poly_clear_denoms_normalization():
+    c = ((a + 1)**2 - a**2 - 2*a - 1)/(a + 2)
+    for gens in ((x,), (x, y), (x, y, z)):
+        zero = Poly(0, *gens, domain=EX)
+        for convert in (False, True):
+            # Keep the coefficient unexpanded until clear_denoms multiplies it.
+            f = Poly.from_dict({(0,)*len(gens): c}, *gens, domain=EX)
+            denominator, cleared = f.clear_denoms(convert=convert)
+            assert denominator == a + 2
+            assert cleared == zero
+            assert cleared.is_zero
+            assert cleared.rep.rep == zero.rep.rep
+            assert cleared.terms_gcd() == ((0,)*len(gens), zero)
+            assert cleared.primitive() == (0, zero)
+            assert cancel(denominator*f.as_expr() - cleared.as_expr()) == 0
+
+            for i in range(len(gens)):
+                monom = [0]*len(gens)
+                terms = {}
+                for degree, coefficient in ((3, c), (2, 2/(a + 2)),
+                                             (1, c), (0, sin(a)/(a + 2))):
+                    monom[i] = degree
+                    terms[tuple(monom)] = coefficient
+                f = Poly.from_dict(terms, *gens, domain=EX)
+                denominator, cleared = f.clear_denoms(convert=convert)
+                assert denominator == a + 2
+                assert cleared == Poly(2*gens[i]**2 + sin(a), *gens, domain=EX)
+                assert cancel(denominator*f.as_expr() - cleared.as_expr()) == 0
+
+
