index a09ff11..fa94026 100644
--- a/sympy/core/tests/test_numbers.py
+++ b/sympy/core/tests/test_numbers.py
@@ -24,6 +24,72 @@ def same_and_same_prec(a, b):
     return a == b and a._prec == b._prec
 
 
+def test_equality_reflected():
+    from sympy.core.basic import Basic
+
+    class Box:
+        def __eq__(self, other):
+            if isinstance(other, Basic):
+                return True
+            return NotImplemented
+
+        def __ne__(self, other):
+            return not self == other
+
+    class Declining:
+        def __eq__(self, other):
+            return NotImplemented
+
+        def __ne__(self, other):
+            return NotImplemented
+
+    class IndependentComparisons(Box):
+        def __ne__(self, other):
+            return True
+
+    box = Box()
+    for value in [S.Zero, S.One, S.NegativeOne, S.Half, Integer(3),
+                  Rational(2, 3), Float(3), oo, -oo, nan, zoo, I,
+                  pi, E, GoldenRatio, EulerGamma, Catalan]:
+        assert value.__eq__(box) is NotImplemented
+        assert value.__ne__(box) is NotImplemented
+        assert (box == value) is True
+        assert (value == box) is True
+        assert (box != value) is False
+        assert (value != box) is False
+        independent = IndependentComparisons()
+        assert (value == independent) is True
+        assert (value != independent) is True
+        assert (independent != value) is True
+        for other in [object(), Declining(), None, [], str(value)]:
+            assert (value == other) is False
+            assert (other == value) is False
+            assert (value != other) is True
+            assert (other != value) is True
+
+
+def test_equality_sympifiable():
+    class Convertible:
+        def __init__(self, value):
+            self.value = value
+
+        def _sympy_(self):
+            return self.value
+
+    for value in [Integer(3), Rational(2, 3), Float(3), pi]:
+        other = Convertible(value)
+        assert (value == other) is True
+        assert (value != other) is False
+
+    # These singletons have historically used identity, even for operands
+    # that sympify to the singleton. Keep that behavior.
+    for value in [oo, -oo, nan]:
+        assert (value == value) is True
+        assert (value != value) is False
+        assert (value == Convertible(value)) is False
+        assert (value != Convertible(value)) is True
+
+
