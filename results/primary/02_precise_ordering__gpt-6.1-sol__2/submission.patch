+def test_numbersymbol_scalar_ordering():
+    def check_less(a, b):
+        assert (a < b) is S.true
+        assert (a <= b) is S.true
+        assert (a > b) is S.false
+        assert (a >= b) is S.false
+        assert (b > a) is S.true
+        assert (b >= a) is S.true
+        assert (b < a) is S.false
+        assert (b <= a) is S.false
+
+    r = Rational('905502432259640373/288230376151711744')
+    check_less(pi, r)
+    check_less(r - Rational(18, r.q), pi)
+    check_less(pi, Float(r, 30))
+    # The binary value of the default-precision approximation is below pi.
+    check_less(pi.evalf(), pi)
+
+    # Decimal bounds closer than default evalf precision, for every constant.
+    for constant, lower in [
+            (pi, '3.14159265358979323846'),
+            (E, '2.71828182845904523536'),
+            (GoldenRatio, '1.61803398874989484820'),
+            (EulerGamma, '0.57721566490153286060'),
+            (Catalan, '0.91596559417721901505')]:
+        lower = Rational(lower)
+        upper = lower + Rational(1, 10**20)
+        for a, b in [(lower, upper), (Float(lower, 30), Float(upper, 30)),
+                     (S.Zero, S(4)), (S.NegativeInfinity, S.Infinity)]:
+            check_less(a, constant)
+            check_less(constant, b)
+
+
+def test_numbersymbol_scalar_boundary():
+    from sympy.core.numbers import NumberSymbol
+
+    # An exact scalar boundary distinguishes strict from inclusive reflection.
+    class ZeroSymbol(NumberSymbol):
+        is_zero = True
+
+        def _as_mpf_val(self, prec):
+            return S.Zero._as_mpf_val(prec)
+
+    z = ZeroSymbol()
+    for scalar in [S.Zero, Float(0)]:
+        for a, b in [(z, scalar), (scalar, z)]:
+            assert (a < b) is S.false
+            assert (a > b) is S.false
+            assert (a <= b) is S.true
+            assert (a >= b) is S.true
+
+
+def test_numbersymbol_symbolic_ordering():
+    x = Symbol('x', real=True)
+    for a, b in [(pi, x), (x, pi)]:
+        assert (a < b) == Lt(a, b, evaluate=False)
+        assert (a <= b) == Le(a, b, evaluate=False)
+        assert (a > b) == Gt(a, b, evaluate=False)
+        assert (a >= b) == Ge(a, b, evaluate=False)
+
+
