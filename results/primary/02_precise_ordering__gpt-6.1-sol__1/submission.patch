+def test_numbersymbol_close_comparisons():
+    r = Rational('905502432259640373/288230376151711744')
+    # This exact value is above pi, but rounds to pi at default precision.
+    for above in (r, Float(r, 70)):
+        assert (above < pi) is S.false
+        assert (above <= pi) is S.false
+        assert (above > pi) is S.true
+        assert (above >= pi) is S.true
+        assert (pi < above) is S.true
+        assert (pi <= above) is S.true
+        assert (pi > above) is S.false
+        assert (pi >= above) is S.false
+
+    # Decimal bounds much closer than the default evaluation precision.
+    bounds = [
+        (pi, '3.141592653589793238462643383279'),
+        (E, '2.718281828459045235360287471352'),
+        (GoldenRatio, '1.618033988749894848204586834365'),
+        (EulerGamma, '0.577215664901532860606512090082'),
+        (Catalan, '0.915965594177219015054603514932'),
+    ]
+    for constant, lower in bounds:
+        lower = Rational(lower)
+        upper = lower + Rational(1, 10**30)
+        for a, b in [(lower, upper), (Float(lower, 40), Float(upper, 40))]:
+            assert (a < constant) is (constant > a) is S.true
+            assert (a <= constant) is (constant >= a) is S.true
+            assert (a > constant) is (constant < a) is S.false
+            assert (a >= constant) is (constant <= a) is S.false
+            assert (b > constant) is (constant < b) is S.true
+            assert (b >= constant) is (constant <= b) is S.true
+            assert (b < constant) is (constant > b) is S.false
+            assert (b <= constant) is (constant >= b) is S.false
+
+    # The rounded Float is an exact binary value below pi, not equal to pi.
+    below = pi.evalf()
+    assert (below < pi) is (pi > below) is S.true
+    assert (below <= pi) is (pi >= below) is S.true
+    assert (below > pi) is (pi < below) is S.false
+    assert (below >= pi) is (pi <= below) is S.false
+
+
+def test_numbersymbol_comparison_boundaries():
+    from sympy.core.numbers import NumberSymbol
+
+    class ZeroConstant(NumberSymbol):
+        is_zero = True
+
+        def _eval_evalf(self, prec):
+            return S.Zero
+
+        def approximation_interval(self, number_cls):
+            return None
+
+    # A rational-valued NumberSymbol makes strictness observable in scalar
+    # comparisons: equality must satisfy only the inclusive orderings.
+    zero = ZeroConstant()
+    for scalar in (S.Zero, Float(0)):
+        assert (scalar < zero) is (zero > scalar) is S.false
+        assert (scalar > zero) is (zero < scalar) is S.false
+        assert (scalar <= zero) is (zero >= scalar) is S.true
+        assert (scalar >= zero) is (zero <= scalar) is S.true
+
+    for constant in (pi, E, GoldenRatio, EulerGamma, Catalan):
+        assert (constant < constant) is S.false
+        assert (constant > constant) is S.false
+        assert (constant <= constant) is S.true
+        assert (constant >= constant) is S.true
+        for lower, upper in [(S.Zero, S(4)), (Float(0), Float(4)), (-oo, oo)]:
+            assert (lower < constant) is (constant > lower) is S.true
+            assert (lower <= constant) is (constant >= lower) is S.true
+            assert (lower > constant) is (constant < lower) is S.false
+            assert (lower >= constant) is (constant <= lower) is S.false
+            assert (upper > constant) is (constant < upper) is S.true
+            assert (upper >= constant) is (constant <= upper) is S.true
+            assert (upper < constant) is (constant > upper) is S.false
+            assert (upper <= constant) is (constant >= upper) is S.false
+
+
+def test_numbersymbol_undecidable_comparisons():
+    from sympy.core.numbers import NumberSymbol
+
+    class UnknownConstant(NumberSymbol):
+        is_real = True
+
+        def _eval_evalf(self, prec):
+            return None
+
+        def approximation_interval(self, number_cls):
+            return None
+
+    constant = UnknownConstant()
+    # Delegating to the other operand must preserve strictness even when
+    # the result is symbolic, rather than relying on the values being unequal.
+    for scalar in (S.Half, Float('0.5')):
+        for relation, reverse in [(Lt, Gt), (Le, Ge), (Gt, Lt), (Ge, Le)]:
+            expected = reverse(constant, scalar, evaluate=False)
+            assert relation(scalar, constant) == expected
+            assert reverse(constant, scalar) == expected
+
+    x = Symbol('x', real=True)
+    for relation in (Lt, Le, Gt, Ge):
+        assert relation(pi, x) == relation(pi, x, evaluate=False)
+        assert relation(x, pi) == relation(x, pi, evaluate=False)
+
