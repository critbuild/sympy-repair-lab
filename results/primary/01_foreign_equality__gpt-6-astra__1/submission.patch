diff --git a/sympy/core/tests/test_basic.py b/sympy/core/tests/test_basic.py
index 9d4a8fa..1d27939 100644
--- a/sympy/core/tests/test_basic.py
+++ b/sympy/core/tests/test_basic.py
@@ -39,6 +39,58 @@ def test_equality():
     assert not(Basic() == 0)
 
 
+def test_equality_reflected():
+    from sympy import Integer, Rational, Float, Dummy
+
+    class Box:
+        def __eq__(self, other):
+            if isinstance(other, Basic):
+                return True
+            return NotImplemented
+
+        def __ne__(self, other):
+            return not self == other
+
+    class Declines:
+        def __eq__(self, other):
+            return NotImplemented
+
+        def __ne__(self, other):
+            return NotImplemented
+
+    class ComparisonResults:
+        # Reflected comparisons may return arbitrary objects, and __ne__
+        # need not be the negation of __eq__.
+        eq_result = object()
+        ne_result = object()
+
+        def __eq__(self, other):
+            return self.eq_result
+
+        def __ne__(self, other):
+            return self.ne_result
+
+    box = Box()
+    results = ComparisonResults()
+    values = [Basic(), symbols('x'), Dummy('x'), Integer(3), S.Zero,
+              S.One, S.NegativeOne, Rational(1, 2), Float(3), S.Infinity,
+              S.NegativeInfinity, S.NaN, S.ComplexInfinity, I, pi]
+    for value in values:
+        assert value.__eq__(box) is NotImplemented
+        assert value.__ne__(box) is NotImplemented
+        assert (box == value) is True
+        assert (value == box) is True
+        assert (box != value) is False
+        assert (value != box) is False
+        assert (value == results) is results.eq_result
+        assert (value != results) is results.ne_result
+        for other in [object(), Declines(), None, [], '3']:
+            assert (value == other) is False
+            assert (other == value) is False
+            assert (value != other) is True
+            assert (other != value) is True
+
+
