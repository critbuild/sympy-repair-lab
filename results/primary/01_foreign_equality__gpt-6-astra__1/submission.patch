diff --git a/sympy/core/tests/test_numbers.py b/sympy/core/tests/test_numbers.py
index a09ff11..d380be3 100644
--- a/sympy/core/tests/test_numbers.py
+++ b/sympy/core/tests/test_numbers.py
@@ -46,6 +46,37 @@ def test_integers_cache():
     assert hash(python_int) in _intcache
 
 
+def test_equality_sympifiable_operands():
+    class Convertible:
+        def __init__(self, value):
+            self.value = value
+
+        def _sympy_(self):
+            return self.value
+
+        def __eq__(self, other):
+            raise AssertionError('Successful sympification should decide equality')
+
+        def __ne__(self, other):
+            raise AssertionError('Successful sympification should decide inequality')
+
+    for value in [Integer(3), Rational(1, 2), Float(3), pi, Symbol('x')]:
+        assert (value == Convertible(value)) is True
+        assert (value != Convertible(value)) is False
+        assert (value == Convertible(Symbol('other'))) is False
+        assert (value != Convertible(Symbol('other'))) is True
+
+    # These singletons retain identity-based equality even when the other
+    # operand can be converted to the same singleton.
+    for value, native in [(oo, float('inf')), (-oo, float('-inf')),
+                          (nan, float('nan'))]:
+        assert (value == value) is True
+        assert (value != value) is False
+        for other in [native, Convertible(value)]:
+            assert (value == other) is False
+            assert (value != other) is True
+
+
