+def test_mul_ground_cancellation():
+    c = EX(t - 1)
+    zero = EX((t**2 - 1)/(t - 1) - t - 1)
+    assert dup_mul_ground([zero], c, EX) == []
+    assert dup_mul_ground([zero, EX(t), EX.zero], c, EX) == [
+        EX(t**2 - t), EX.zero]
+    assert dmp_mul_ground([[zero], [zero]], c, 1, EX) == [[]]
+    assert dmp_mul_ground([[[zero]], [[zero]]], c, 2, EX) == [[[]]]
+    assert dmp_mul_ground([[zero], [zero, EX.one], []], c, 1, EX) == [
+        [c], []]
+    assert dmp_mul_ground([[EX.one], [EX.one]], EX.zero, 1, EX) == [[]]
